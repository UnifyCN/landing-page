# Browser caching for static assets (Cloudflare Workers static assets).
# Without this every file shipped with `max-age=0, must-revalidate`, so each
# page view re-checked every font, image and script with the server.

# Content-hashed build output: safe to cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts never change under the same name.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images, videos, logos: stable names, occasionally replaced in place.
# A week in the browser, revalidated after that.
/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/favicon*
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
