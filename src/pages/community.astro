---
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";
import CommunityHero from "../components/sections/CommunityHero.astro";
import CommunityStats from "../components/sections/CommunityStats.astro";
import CommunityGallery from "../components/sections/CommunityGallery.astro";
import CommunityEventCTA from "../components/sections/CommunityEventCTA.astro";
import CTABand from "../components/sections/CTABand.astro";
---

<BaseLayout
  title="Newcomer Events in Vancouver — Workshops & Community | Unify"
  description="Free newcomer events, workshops, and community meetups across Metro Vancouver. Join 400+ newcomers who've connected in person through Unify Gather."
  bodyBg="#171616"
>
  <main>
    <CommunityHero />
    <CommunityStats />
    <CommunityGallery />
    <CommunityEventCTA />
    <CTABand />
  </main>
</BaseLayout>
