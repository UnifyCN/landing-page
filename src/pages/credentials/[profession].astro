---
export const prerender = true;

import BaseLayout from "../../layouts/BaseLayout.astro";
import CTABand from "../../components/sections/CTABand.astro";
import { CREDENTIALS, regulatedCount, type CredentialProfession } from "../../lib/credentials";
import { breadcrumbLd, faqLd, serializeLd } from "../../lib/seo";
import "../../styles/cluster.css";

export async function getStaticPaths() {
  return CREDENTIALS.map((c) => ({ params: { profession: c.slug }, props: { prof: c } }));
}

const { prof } = Astro.props as { prof: CredentialProfession };
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const count = regulatedCount(prof);
const regulatedLabel =
  prof.regulatedLabel ?? (count === 13 ? "All 13 provinces and territories" : `${count} of 13 provinces and territories`);
/** The TEER is the 2nd digit of a NOC 2021 code. */
const teerOf = (noc: string) => noc.charAt(1);

const breadcrumbLdStr = serializeLd(
  breadcrumbLd([
    { name: "Home", item: "https://unifysocial.ca" },
    { name: "Credential Recognition", item: "https://unifysocial.ca/credentials" },
    { name: prof.name, item: canonicalUrl },
  ])
);
const faqLdStr = serializeLd(faqLd(prof.faqs));
---

<BaseLayout title={prof.seoTitle} description={prof.seoDescription} bodyBg="#ffffff">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={breadcrumbLdStr} />
    <script type="application/ld+json" set:html={faqLdStr} />
  </Fragment>

  <main class="cl">
    <nav class="cl-crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/credentials">Credential Recognition</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{prof.name}</span>
    </nav>

    <header class="cl-hero">
      <p class="cl-eyebrow">Licensing in Canada</p>
      <h1 class="cl-h1">{prof.h1}</h1>
      <p class="cl-lead">{prof.lead}</p>
    </header>

    <aside class="cl-verdict" aria-label="At a glance">
      <div class="cl-verdict-item">
        <span class="cl-verdict-label">Regulated in</span>
        <strong class="cl-verdict-value">{regulatedLabel}</strong>
      </div>
      <div class="cl-verdict-item">
        <span class="cl-verdict-label">First step</span>
        <strong class="cl-verdict-value">{prof.firstStep}</strong>
      </div>
      <div class="cl-verdict-item">
        <span class="cl-verdict-label">Licensing exam</span>
        <strong class="cl-verdict-value">{prof.examShort}</strong>
      </div>
    </aside>

    <section class="cl-block" aria-labelledby="how-h">
      <h2 id="how-h" class="cl-h2">How to get licensed as an internationally trained {prof.name.toLowerCase()}</h2>
      <ol class="cl-steps">
        {prof.steps.map((s) => (
          <li><strong>{s.title}.</strong> {s.body}</li>
        ))}
      </ol>
      {prof.timeline && (
        <p class="cl-microcopy">
          How long it takes: {prof.timeline.text}
          (<a href={prof.timeline.source} target="_blank" rel="noopener noreferrer">source</a>).
        </p>
      )}
    </section>

    {prof.recentChange && (
      <section class="cl-block" aria-labelledby="new-h">
        <h2 id="new-h" class="cl-h2">What changed recently</h2>
        <p class="cl-body">
          {prof.recentChange.text}
          (<a href={prof.recentChange.source} target="_blank" rel="noopener noreferrer">source</a>)
        </p>
      </section>
    )}

    <section class="cl-block" aria-labelledby="reg-h">
      <h2 id="reg-h" class="cl-h2">{prof.name} regulator in each province and territory</h2>
      <div class="cl-table-wrap" role="region" aria-labelledby="reg-h" tabindex="0">
        <table class="cl-table cl-table--fit">
          <thead>
            <tr>
              <th scope="col">Province / territory</th>
              <th scope="col">Regulator</th>
            </tr>
          </thead>
          <tbody>
            {prof.regulators.map((r) => (
              <tr>
                <th scope="row">{r.province}</th>
                <td>
                  {r.url ? (
                    <a href={r.url} target="_blank" rel="noopener noreferrer">{r.regulator}</a>
                  ) : (
                    <span>{r.regulator}</span>
                  )}
                  {r.note && <span class="cl-cell-note">{r.note}</span>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="cl-microcopy">
        You apply to the regulator in the province or territory where you plan to work. Moving
        later is usually simpler: a licence in one province can often be transferred to another.
      </p>
    </section>

    {(prof.nationalBodies.length > 0 || prof.exams.length > 0) && (
      <section class="cl-block" aria-labelledby="exam-h">
        <h2 id="exam-h" class="cl-h2">Assessments, exams, and language tests</h2>
        {prof.nationalBodies.length > 0 && (
          <ul class="cl-list">
            {prof.nationalBodies.map((b) => (
              <li>
                <a href={b.url} target="_blank" rel="noopener noreferrer">{b.name}</a>: {b.role}
              </li>
            ))}
          </ul>
        )}
        {prof.exams.length > 0 && (
          <p class="cl-body">
            <strong>Exams:</strong> {prof.exams.join("; ")}.
          </p>
        )}
        <p class="cl-body"><strong>Language:</strong> {prof.language}</p>
      </section>
    )}

    <section class="cl-block" aria-labelledby="work-h">
      <h2 id="work-h" class="cl-h2">Jobs you can do while you get licensed</h2>
      <p class="cl-body">
        Licensing takes time. These related jobs use your skills and build Canadian experience.
        Some have their own, simpler requirements.
      </p>
      <div class="cl-table-wrap" role="region" aria-labelledby="work-h" tabindex="0">
        <table class="cl-table cl-table--fit">
          <thead>
            <tr>
              <th scope="col">Job</th>
              <th scope="col">What to know</th>
            </tr>
          </thead>
          <tbody>
            {prof.workWhileLicensing.map((w) => (
              <tr>
                <th scope="row">
                  <span class="cl-row-label">{w.role}</span>
                  <a class="cl-row-sub" href={`/teer/teer-${teerOf(w.noc)}#full-list`}>NOC {w.noc}, TEER {teerOf(w.noc)}</a>
                </th>
                <td>{w.note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="cl-block" aria-labelledby="noc-h">
      <h2 id="noc-h" class="cl-h2">NOC code and TEER for {prof.plural}</h2>
      <ul class="cl-list">
        {prof.nocCodes.map((n) => (
          <li>
            <strong>{n.noc}</strong> {n.title}:
            <a href={`/teer/teer-${teerOf(n.noc)}`}>TEER {teerOf(n.noc)}</a>
          </li>
        ))}
      </ul>
      <p class="cl-body">
        Immigration programs use the NOC code and TEER of your job.
        {prof.protectedTitles.length > 0 && (
          <>Titles you cannot use without a licence: {prof.protectedTitles.join(", ")}.</>
        )}
      </p>
    </section>

    <section class="cl-block" aria-labelledby="guide-h">
      <h2 id="guide-h" class="cl-h2">What this means for newcomers</h2>
      <p class="cl-body">
        Contact the regulator in the province where you plan to live before you do anything else,
        and ask what it needs from outside Canada. Documents from your school and past regulators
        often take the longest, so request them early. Keep working in a related job while you wait,
        and put your licensing stage on your <a href="/canadian-resume">Canadian resume</a>.
      </p>
      <p class="cl-body cl-app">
        The <a href="/">Unify newcomer settlement app</a> keeps your licensing steps, documents, and
        deadlines in one free checklist, next to your SIN, bank account, and health card.
      </p>
      <a
        class="cl-related"
        href="/blog/credential-recognition-in-canada-a-step-by-step-guide-for-internationally-trained-professionals"
      >
        <span class="cl-related-kicker">Related guide</span>
        <span class="cl-related-title">Credential recognition in Canada, step by step &rarr;</span>
      </a>
    </section>

    <section class="cl-block" aria-labelledby="faq-h">
      <h2 id="faq-h" class="cl-h2">{prof.plural.charAt(0).toUpperCase() + prof.plural.slice(1)} trained abroad: common questions</h2>
      <div class="cl-faq">
        {prof.faqs.map((f) => (
          <details class="cl-faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <nav class="cl-siblings" aria-label="Licensing by profession">
      <span class="cl-siblings-label">Licensing by profession</span>
      <ul role="list">
        {CREDENTIALS.map((c) => (
          <li>
            <a
              href={`/credentials/${c.slug}`}
              class={c.slug === prof.slug ? "is-current" : ""}
              aria-current={c.slug === prof.slug ? "page" : undefined}
            >
              {c.shortName}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <p class="cl-verified">
      Checked against the regulators and national bodies linked above, and
      {prof.sources.slice(0, 3).map((s, i, arr) => (
        <>
          <a href={s.url} target="_blank" rel="noopener noreferrer">{new URL(s.url).hostname.replace(/^www\./, "")}</a>{i < arr.length - 1 ? ", " : ""}
        </>
      ))}, in {prof.lastVerified}. Requirements change; confirm with the regulator before you apply.
    </p>
  </main>

  <CTABand />
</BaseLayout>
