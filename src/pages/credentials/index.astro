---
export const prerender = true;

import BaseLayout from "../../layouts/BaseLayout.astro";
import CTABand from "../../components/sections/CTABand.astro";
import {
  CREDENTIALS,
  CREDENTIAL_GROUPS,
  CREDENTIALS_HUB_FAQS,
  FCR_TOOL_URL,
  CICIC_REGULATED_URL,
  regulatedCount,
} from "../../lib/credentials";
import { breadcrumbLd, faqLd, serializeLd } from "../../lib/seo";
import "../../styles/cluster.css";

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;

const breadcrumbLdStr = serializeLd(
  breadcrumbLd([
    { name: "Home", item: "https://unifysocial.ca" },
    { name: "Credential Recognition", item: canonicalUrl },
  ])
);
const faqLdStr = serializeLd(faqLd(CREDENTIALS_HUB_FAQS));
---

<BaseLayout
  title="Foreign Credential Recognition in Canada, by Profession"
  description="How internationally trained nurses, doctors, engineers, teachers, accountants, and tradespeople get licensed in Canada, with the regulator in every province."
  bodyBg="#ffffff"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={breadcrumbLdStr} />
    <script type="application/ld+json" set:html={faqLdStr} />
  </Fragment>

  <main class="cl cl--wide">
    <nav class="cl-crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Credential Recognition</span>
    </nav>

    <header class="cl-hero">
      <p class="cl-eyebrow">Work in your profession</p>
      <h1 class="cl-h1">Foreign Credential Recognition in Canada: How to Get Licensed in Your Profession</h1>
      <p class="cl-lead">
        About 20% of jobs in Canada are regulated. For those jobs,
        <strong>a provincial or territorial regulator decides if your foreign training counts</strong>,
        and you need its licence before you can work under the title. For the other 80%, the
        employer decides. Find your profession below for the steps, the exams, and the regulator in
        each province.
      </p>
    </header>

    <section class="cl-block" aria-labelledby="compare-h">
      <h2 id="compare-h" class="cl-h2">Licensing at a glance, by profession</h2>
      <div class="cl-table-wrap" role="region" aria-labelledby="compare-h" tabindex="0">
        <table class="cl-table cl-table--hub">
          <thead>
            <tr>
              <th scope="col">Profession</th>
              <th scope="col">Regulated in</th>
              <th scope="col" class="cl-col-extra">First step</th>
              <th scope="col" class="cl-col-extra">Licensing exam</th>
            </tr>
          </thead>
          <tbody>
            {CREDENTIALS.map((c) => (
              <tr>
                <th scope="row"><a href={`/credentials/${c.slug}`}>{c.name}</a></th>
                <td>
                  <span class={`cl-pill ${c.regulatedIn === "all" ? "is-yes" : "is-no"}`}>
                    {c.regulatedLabel ?? `${regulatedCount(c)} of 13`}
                  </span>
                </td>
                <td class="cl-col-extra">{c.firstStep}</td>
                <td class="cl-col-extra">{c.examShort}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="cl-microcopy">
        "Regulated in" counts the provinces and territories where a licence or certificate is
        required by law. Where a job is not regulated, employers set their own requirements.
      </p>
    </section>

    <section class="cl-block" aria-labelledby="eca-h">
      <h2 id="eca-h" class="cl-h2">An ECA is not a licence</h2>
      <p class="cl-body">
        The Educational Credential Assessment (ECA) you used for Express Entry shows that your
        degree equals a Canadian one. IRCC says it does not guarantee a licence to practise or a
        job in your field. For a regulated job, the regulator runs its own assessment, even if you
        already have an ECA. Start with the regulator as early as you can: many accept applications
        before you arrive.
      </p>
    </section>

    {CREDENTIAL_GROUPS.map((g) => {
      const items = CREDENTIALS.filter((c) => c.group === g.value);
      return items.length > 0 && (
        <section class="cl-block" aria-labelledby={`grp-${g.value}`}>
          <h2 id={`grp-${g.value}`} class="cl-h2">{g.label}</h2>
          <ul class="cl-cards" role="list">
            {items.map((c) => (
              <li>
                <a class="cl-card" href={`/credentials/${c.slug}`}>
                  <span class="cl-card-title">{c.name}</span>
                  <span class={`cl-pill ${c.regulatedIn === "all" ? "is-yes" : "is-no"}`}>
                    {c.regulatedLabel ?? `Regulated in ${regulatedCount(c)} of 13`}
                  </span>
                  <span class="cl-card-desc">{c.firstStep}. {c.examShort}.</span>
                  <span class="cl-card-go" aria-hidden="true">Licensing steps &rarr;</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      );
    })}

    <section class="cl-block" aria-labelledby="other-h">
      <h2 id="other-h" class="cl-h2">Profession not listed?</h2>
      <p class="cl-body">
        Use the Government of Canada's
        <a href={FCR_TOOL_URL} target="_blank" rel="noopener noreferrer">foreign credential recognition tool</a>
        or the
        <a href={CICIC_REGULATED_URL} target="_blank" rel="noopener noreferrer">CICIC directory of regulated occupations</a>
        to find out if your job is regulated where you plan to live. To find the Canadian name and
        NOC code for your job, see the <a href="/teer">TEER categories and NOC job lists</a>.
      </p>
      <p class="cl-body cl-app">
        Licensing can take months. The <a href="/">Unify newcomer settlement app</a> keeps your
        credential steps next to your SIN, bank account, and health card in one free checklist, and
        a <a href="/canadian-resume">Canadian-style resume</a> helps you find related work while you wait.
      </p>
      <a
        class="cl-related"
        href="/blog/credential-recognition-in-canada-a-step-by-step-guide-for-internationally-trained-professionals"
      >
        <span class="cl-related-kicker">Related guide</span>
        <span class="cl-related-title">Credential recognition in Canada, step by step &rarr;</span>
      </a>
    </section>

    <section class="cl-block" aria-labelledby="faq-h">
      <h2 id="faq-h" class="cl-h2">Credential recognition: common questions</h2>
      <div class="cl-faq">
        {CREDENTIALS_HUB_FAQS.map((f) => (
          <details class="cl-faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </main>

  <CTABand />
</BaseLayout>
