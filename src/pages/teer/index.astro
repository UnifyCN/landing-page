---
export const prerender = true;

import BaseLayout from "../../layouts/BaseLayout.astro";
import CTABand from "../../components/sections/CTABand.astro";
import { TEER_TIERS, TEER_HUB_FAQS, NOC_FINDER_URL, EE_2026_NOTE } from "../../lib/teer";
import { breadcrumbLd, faqLd, serializeLd } from "../../lib/seo";

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;

const breadcrumbLdStr = serializeLd(
  breadcrumbLd([
    { name: "Home", item: "https://unifysocial.ca" },
    { name: "TEER Categories", item: canonicalUrl },
  ])
);
const faqLdStr = serializeLd(faqLd(TEER_HUB_FAQS));
---

<BaseLayout
  title="What Is TEER? Canada's NOC Categories & PR Eligibility"
  description="TEER is how Canada's NOC ranks jobs into six categories. TEER 0-3 are high-skilled and Express Entry eligible; TEER 4-5 are not. See the full breakdown."
  bodyBg="#ffffff"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={breadcrumbLdStr} />
    <script type="application/ld+json" set:html={faqLdStr} />
  </Fragment>

  <main class="teer">
    <nav class="teer-crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">TEER Categories</span>
    </nav>

    <header class="teer-hero">
      <p class="teer-eyebrow">Skilled Work &amp; PR</p>
      <h1 class="teer-h1">TEER Categories in Canada: Jobs, NOC Codes &amp; PR Eligibility</h1>
      <p class="teer-lead">
        TEER (Training, Education, Experience and Responsibilities) is how Canada's National
        Occupational Classification sorts every job into six categories, TEER 0 to TEER 5.
        <strong>TEER 0-3 are high-skilled and eligible for Express Entry</strong> permanent
        residency; TEER 4-5 are lower-skilled and are not. Your job's TEER decides which
        immigration programs you qualify for.
      </p>
    </header>

    <!-- Comparison table (extractable for AI answers + screen readers) -->
    <section class="teer-block" aria-labelledby="compare-h">
      <h2 id="compare-h" class="teer-h2">The six TEER categories at a glance</h2>
      <div class="teer-table-wrap" role="region" aria-labelledby="compare-h" tabindex="0">
        <table class="teer-table">
          <thead>
            <tr>
              <th scope="col">Category</th>
              <th scope="col">What it usually needs</th>
              <th scope="col">Skill level</th>
              <th scope="col">Express Entry</th>
              <th scope="col">Example jobs</th>
            </tr>
          </thead>
          <tbody>
            {TEER_TIERS.map((t) => (
              <tr>
                <th scope="row" class="teer-td-cat">
                  <a href={`/teer/${t.slug}`}>TEER {t.tier}</a>
                </th>
                <td>{t.requirements.split(".")[0]}.</td>
                <td>{t.skillLevel}</td>
                <td>
                  <span class={`teer-pill ${t.expressEntryEligible ? "is-yes" : "is-no"}`}>
                    {t.expressEntryEligible ? "Eligible" : "Not eligible"}
                  </span>
                </td>
                <td>{t.occupations.slice(0, 2).map((o) => o.title).join(", ")}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="teer-note">{EE_2026_NOTE}</p>
    </section>

    <!-- Which TEER is eligible for PR -->
    <section class="teer-block" aria-labelledby="pr-h">
      <h2 id="pr-h" class="teer-h2">Which TEER is eligible for PR in Canada?</h2>
      <p class="teer-body">
        Only the high-skilled categories qualify for Express Entry, the main federal route to
        permanent residency: <strong>TEER 0, 1, 2, and 3</strong>. The Canadian Experience Class
        asks for CLB 7 language for TEER 0-1 and CLB 5 for TEER 2-3. TEER 4 and 5 do not qualify
        for Express Entry, but a Provincial Nominee Program, the Atlantic Immigration Program, or a
        sector pilot can still open a PR pathway.
      </p>
    </section>

    <!-- Tier cards -->
    <section class="teer-block" aria-labelledby="cards-h">
      <h2 id="cards-h" class="teer-h2">Explore each TEER category</h2>
      <ul class="teer-cards" role="list">
        {TEER_TIERS.map((t) => (
          <li>
            <a class="teer-card" href={`/teer/${t.slug}`}>
              <span class="teer-card-num">TEER {t.tier}</span>
              <span class={`teer-pill ${t.expressEntryEligible ? "is-yes" : "is-no"}`}>
                {t.expressEntryEligible ? "Express Entry eligible" : "Not Express Entry eligible"}
              </span>
              <span class="teer-card-desc">{t.lead.split(".")[0]}.</span>
              <span class="teer-card-go" aria-hidden="true">View TEER {t.tier} jobs &rarr;</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- How to find your TEER -->
    <section class="teer-block" aria-labelledby="find-h">
      <h2 id="find-h" class="teer-h2">How to find your TEER category</h2>
      <p class="teer-body">
        Look up your job's 5-digit NOC 2021 code with the official IRCC tool. The
        <strong> second digit of that code is your TEER</strong>, so NOC 63200 (cooks) is TEER 3.
      </p>
      <a class="teer-textlink" href={NOC_FINDER_URL} target="_blank" rel="noopener noreferrer">
        Find your NOC code on Canada.ca &rarr;
      </a>
    </section>

    <!-- FAQ -->
    <section class="teer-block" aria-labelledby="faq-h">
      <h2 id="faq-h" class="teer-h2">TEER, NOC &amp; PR: common questions</h2>
      <div class="teer-faq">
        {TEER_HUB_FAQS.map((f) => (
          <details class="teer-faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </main>

  <CTABand />
</BaseLayout>

<style>
  .teer {
    max-width: 980px;
    margin: 0 auto;
    padding: clamp(1.5rem, 4vw, 3rem) clamp(1.25rem, 5vw, 2rem) clamp(3rem, 7vw, 5rem);
    color: var(--color-text);
  }

  .teer-crumbs {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    font-family: var(--font-ui);
    font-size: 0.82rem;
    color: var(--color-muted);
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }
  .teer-crumbs a { color: var(--color-muted); text-decoration: none; }
  .teer-crumbs a:hover { color: var(--color-brand-red); }
  .teer-crumbs span[aria-current] { color: var(--color-text); }

  /* Hero */
  .teer-hero { margin-bottom: clamp(2.5rem, 6vw, 4rem); }
  .teer-eyebrow {
    font-family: var(--font-ui);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-brand-red);
    margin: 0 0 1rem;
  }
  .teer-h1 {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: var(--tracking-display);
    line-height: 1.02;
    font-size: clamp(2.1rem, 6vw, 3.6rem);
    margin: 0 0 1.25rem;
    max-width: 16ch;
  }
  .teer-lead {
    font-size: clamp(1.05rem, 2.4vw, 1.35rem);
    line-height: 1.5;
    color: var(--color-muted);
    max-width: 60ch;
    margin: 0;
  }
  .teer-lead strong { color: var(--color-text); font-weight: 600; }

  /* Blocks */
  .teer-block { margin-top: clamp(2.5rem, 6vw, 4rem); }
  .teer-h2 {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    line-height: 1.1;
    font-size: clamp(1.5rem, 3.5vw, 2.1rem);
    margin: 0 0 1.25rem;
  }
  .teer-body {
    font-size: clamp(1rem, 2vw, 1.15rem);
    line-height: 1.65;
    color: var(--color-muted);
    max-width: 62ch;
    margin: 0;
  }
  .teer-body strong { color: var(--color-text); font-weight: 600; }
  .teer-note {
    margin: 1.25rem 0 0;
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--color-muted);
    padding-left: 1rem;
    border-left: 2px solid var(--color-brand-red);
    max-width: 62ch;
  }

  /* Table */
  .teer-table-wrap {
    overflow-x: auto;
    border: 1px solid rgba(23, 22, 22, 0.1);
    border-radius: var(--radius-cta);
    -webkit-overflow-scrolling: touch;
  }
  .teer-table-wrap:focus-visible { outline: 2px solid var(--color-brand-red); outline-offset: 2px; }
  .teer-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 640px;
    font-size: 0.95rem;
  }
  .teer-table th,
  .teer-table td {
    text-align: left;
    padding: 0.85rem 1rem;
    vertical-align: top;
    border-bottom: 1px solid rgba(23, 22, 22, 0.08);
  }
  .teer-table thead th {
    font-family: var(--font-ui);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--color-muted);
    font-weight: 600;
    background: #faf7f1;
    white-space: nowrap;
  }
  .teer-table tbody tr:last-child th,
  .teer-table tbody tr:last-child td { border-bottom: none; }
  .teer-td-cat { white-space: nowrap; }
  .teer-td-cat a {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-text);
    text-decoration: none;
    font-size: 1.05rem;
  }
  .teer-td-cat a:hover { color: var(--color-brand-red); }

  .teer-pill {
    display: inline-block;
    font-family: var(--font-ui);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-pill);
    white-space: nowrap;
  }
  .teer-pill.is-yes { background: rgba(216, 74, 41, 0.1); color: var(--color-brand-red); }
  .teer-pill.is-no { background: rgba(23, 22, 22, 0.06); color: var(--color-muted); }

  /* Cards */
  .teer-cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: clamp(0.85rem, 2vw, 1.25rem);
  }
  .teer-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.7rem;
    height: 100%;
    padding: 1.5rem;
    border: 1px solid rgba(23, 22, 22, 0.12);
    border-radius: var(--radius-cta);
    background: #fff;
    text-decoration: none;
    color: var(--color-text);
    transition: border-color 0.25s var(--ease-out), box-shadow 0.25s var(--ease-out),
      transform 0.25s var(--ease-out);
  }
  .teer-card:hover,
  .teer-card:focus-visible {
    border-color: var(--color-brand-red);
    box-shadow: 0 12px 30px -16px rgba(23, 22, 22, 0.3);
    transform: translateY(-3px);
    outline: none;
  }
  .teer-card-num {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    font-size: 1.5rem;
  }
  .teer-card-desc {
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--color-muted);
    flex: 1;
  }
  .teer-card-go {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color-brand-red);
  }

  .teer-textlink {
    display: inline-block;
    margin-top: 1.1rem;
    font-family: var(--font-ui);
    font-weight: 600;
    color: var(--color-brand-red);
    text-decoration: none;
  }
  .teer-textlink:hover { text-decoration: underline; }

  /* FAQ */
  .teer-faq { border-top: 1px solid rgba(23, 22, 22, 0.1); }
  .teer-faq-item { border-bottom: 1px solid rgba(23, 22, 22, 0.1); }
  .teer-faq-item summary {
    list-style: none;
    cursor: pointer;
    padding: 1.1rem 2.5rem 1.1rem 0;
    position: relative;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.02rem, 2.2vw, 1.18rem);
    color: var(--color-text);
  }
  .teer-faq-item summary::-webkit-details-marker { display: none; }
  .teer-faq-item summary::after {
    content: "+";
    position: absolute;
    right: 0.25rem;
    top: 50%;
    transform: translateY(-50%);
    font-size: 1.4rem;
    color: var(--color-brand-red);
    transition: transform 0.25s var(--ease-out);
  }
  .teer-faq-item[open] summary::after { content: "\2212"; }
  .teer-faq-item summary:focus-visible { outline: 2px solid var(--color-brand-red); outline-offset: 3px; }
  .teer-faq-item p {
    margin: 0;
    padding: 0 0 1.2rem;
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-muted);
    max-width: 64ch;
  }

  @media (prefers-reduced-motion: reduce) {
    .teer-card { transition: border-color 0.25s ease, box-shadow 0.25s ease; }
    .teer-card:hover, .teer-card:focus-visible { transform: none; }
    .teer-faq-item summary::after { transition: none; }
  }
</style>
