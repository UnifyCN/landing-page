---
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactHero from "../components/sections/ContactHero.astro";
import ContactForm from "../components/sections/ContactForm.astro";
import CTABand from "../components/sections/CTABand.astro";
---

<BaseLayout
  title="Contact Unify Social - Questions, Feedback & Partnerships"
  description="Get in touch with the Unify team in Vancouver. Send questions, feedback, or partnership inquiries. We read every message and usually reply in 1-2 business days."
  bodyBg="#171616"
>
  <main>
    <ContactHero />
    <ContactForm />
    <CTABand />
  </main>
</BaseLayout>
