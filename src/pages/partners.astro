---
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";
import PartnersHero from "../components/sections/PartnersHero.astro";
import PartnerTestimonials from "../components/sections/PartnerTestimonials.astro";
import PartnersGrid from "../components/sections/PartnersGrid.astro";
import BecomePartner from "../components/sections/BecomePartner.astro";
import CTABand from "../components/sections/CTABand.astro";
---

<BaseLayout
  title="Newcomer Support Organizations in BC | Unify Partners"
  description="17 trusted organizations supporting newcomers across BC — banks, universities, libraries, and community centres working alongside Unify Social."
  bodyBg="#171616"
>
  <main>
    <PartnersHero />
    <PartnerTestimonials />
    <PartnersGrid />
    <BecomePartner />
    <CTABand />
  </main>
</BaseLayout>
