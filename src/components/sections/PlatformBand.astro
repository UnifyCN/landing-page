---
// "One platform, every device": the web app and the phone app side by side,
// both showing the same Learn lessons (real screenshots). When the section
// scrolls into view the Housing lessons are outlined on the phone, a marker
// travels to the browser, and the same Housing card lights up there. It plays
// on a loop while the section is on screen, pauses off screen, and with
// reduced motion shows the end state (both outlined) without moving.
import WebAppBadge from "../common/WebAppBadge.astro";
import StoreBadges from "../common/StoreBadges.astro";
---

<section class="platform" aria-labelledby="platform-heading">
  <div class="platform-inner">
    <div class="platform-head">
      <h2 class="platform-heading" id="platform-heading">One platform, every device.</h2>
      <p class="platform-desc">
        One free account on iPhone, Android, and the web. Your checklist, lessons, and circle stay in sync.
      </p>
    </div>

    <div class="platform-stage" data-sync>
      <figure class="platform-phone">
        <span class="shot">
          <picture class="contents">
            <source type="image/avif" srcset="/assets/screenshots/hero/learn-360.avif 360w, /assets/screenshots/hero/learn-720.avif 720w" sizes="(min-width: 810px) 218px, 150px" />
            <img
              src="/assets/screenshots/hero/learn-360.webp"
              srcset="/assets/screenshots/hero/learn-360.webp 360w, /assets/screenshots/hero/learn-720.webp 720w"
              sizes="(min-width: 810px) 218px, 150px"
              alt="Learn in the Unify iPhone app, with the Housing lessons"
              width="360"
              height="768"
              loading="lazy"
              decoding="async"
            />
          </picture>
          <span class="ping ping-phone" aria-hidden="true"></span>
        </span>
      </figure>

      <svg class="sync-path" viewBox="0 0 200 60" preserveAspectRatio="none" aria-hidden="true">
        <path class="sync-line" d="M0 40 C 60 40, 80 12, 200 16" />
        <circle class="sync-dot" r="7" cx="0" cy="40" />
      </svg>

      <figure class="platform-browser">
        <div class="browser-bar" aria-hidden="true">
          <span class="browser-dot"></span>
          <span class="browser-dot"></span>
          <span class="browser-dot"></span>
          <span class="browser-url">app.unifysocial.ca</span>
        </div>
        <span class="shot browser-shot-wrap">
          <picture class="contents">
            <source srcset="/assets/screenshots/web/learn-dashboard.avif" type="image/avif" />
            <img
              src="/assets/screenshots/web/learn-dashboard.webp"
              alt="Learn in the Unify web app at app.unifysocial.ca, with the same Housing lessons"
              class="browser-shot"
              width="1033"
              height="1128"
              loading="lazy"
              decoding="async"
            />
          </picture>
          <span class="ping ping-web" aria-hidden="true"></span>
        </span>
      </figure>
    </div>
    <p class="platform-note">The same Housing lessons on your phone and in your browser.</p>

    <div class="platform-cta-row">
      <WebAppBadge placement="platform_band" />
      <StoreBadges lazy placement="platform_band" />
    </div>
    <a class="platform-new" href="/whats-new">
      See what's new in Unify
      <span aria-hidden="true">&rarr;</span>
    </a>
  </div>
</section>

<style>
  .platform {
    background-color: #ffffff;
    padding: 3.5rem 0;
  }

  .platform-inner {
    max-width: var(--spacing-layout);
    margin: 0 auto;
    padding: 0 1.5rem;
    text-align: center;
  }

  .platform-head {
    max-width: 46rem;
    margin: 0 auto 2.25rem;
  }

  .platform-heading {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 4.4vw, 3.5rem);
    line-height: 1.04;
    letter-spacing: var(--tracking-display);
    color: var(--color-text);
    text-wrap: balance;
  }

  .platform-desc {
    margin: 1rem auto 0;
    max-width: 40ch;
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.3vw, 1.125rem);
    line-height: 1.6;
    color: var(--color-muted);
    text-wrap: pretty;
  }

  /* ── Stage: phone, path, browser ── */
  .platform-stage {
    display: grid;
    grid-template-columns: minmax(0, 0.42fr) minmax(0, 0.3fr) minmax(0, 1.28fr);
    align-items: center;
    max-width: 980px;
    margin: 0 auto;
  }

  .platform-phone {
    justify-self: end;
    width: 100%;
    max-width: 232px;
    margin: 0;
    padding: 6px;
    border-radius: 26px;
    background: var(--color-ink);
    box-shadow: 0 26px 50px -26px rgba(23, 22, 22, 0.45);
  }

  .platform-phone img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 20px;
  }

  .shot {
    position: relative;
    display: block;
  }

  .platform-browser {
    margin: 0;
    overflow: hidden;
    border-radius: 12px;
    background: #ffffff;
    box-shadow:
      0 30px 60px -34px rgba(23, 22, 22, 0.45),
      0 0 0 1px rgba(23, 22, 22, 0.08);
  }

  .browser-bar {
    display: flex;
    align-items: center;
    gap: 5px;
    height: 26px;
    padding: 0 10px;
    background: #f3ede4;
  }

  .browser-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #d9d1c5;
  }

  .browser-url {
    margin-left: 8px;
    height: 16px;
    padding: 0 8px;
    border-radius: 5px;
    background: #ffffff;
    font: 500 0.66rem/16px var(--font-ui);
    color: var(--color-muted);
  }

  /* Show the top 3/4 of the dashboard (the Continue Learning cards). */
  .browser-shot-wrap {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .browser-shot {
    display: block;
    width: 100%;
    height: auto;
  }

  .sync-path {
    width: 100%;
    height: 60px;
    overflow: visible;
  }

  .sync-line {
    fill: none;
    stroke: rgba(23, 22, 22, 0.25);
    stroke-width: 2;
    stroke-dasharray: 4 6;
    vector-effect: non-scaling-stroke;
  }

  .sync-dot {
    fill: #e2532a;
    opacity: 0;
  }

  /* Outlines over the Housing card on each screen, in % of the screenshot. */
  .ping {
    position: absolute;
    border: 3px solid #e2532a;
    border-radius: 12px;
    opacity: 0;
    transform: scale(0.94);
    transition:
      opacity 0.35s ease,
      transform 0.5s var(--ease-out);
    pointer-events: none;
  }

  .ping-phone {
    left: 2%;
    width: 47%;
    top: 57.5%;
    height: 14.5%;
  }

  .ping-web {
    left: 33.6%;
    width: 33.4%;
    top: 29.4%;
    height: 35.4%;
  }

  .platform-stage.p-on .ping-phone,
  .platform-stage.w-on .ping-web {
    opacity: 1;
    transform: none;
  }

  .platform-note {
    margin: 1.25rem auto 0;
    font-family: var(--font-display);
    font-size: 0.875rem;
    color: var(--color-muted);
  }

  .platform-cta-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .platform-new {
    display: inline-flex;
    gap: 0.4rem;
    margin-top: 1rem;
    padding: 0.5rem 0;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 0.9375rem;
    color: #b5391c;
    text-decoration: none;
  }

  .platform-new span {
    transition: transform 0.3s var(--ease-out);
  }

  .platform-new:hover span {
    transform: translateX(4px);
  }

  .platform-new:focus-visible {
    outline: 2px solid #b83c1e;
    outline-offset: 3px;
  }

  /* Scroll reveal (progressive: only with JS, see the script) */
  .platform.animate .platform-stage {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.7s var(--ease-out),
      transform 0.7s var(--ease-out);
  }

  .platform.animate.visible .platform-stage {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 700px) {
    .platform-stage {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 0.5rem;
    }

    .platform-phone {
      justify-self: center;
      max-width: 162px;
    }

    .sync-path {
      width: 60px;
      transform: rotate(90deg);
    }
  }

  @media (min-width: 810px) {
    .platform {
      padding: 4.5rem 0;
    }

    .platform-inner {
      padding: 0 3rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ping {
      transition: none;
    }
  }
</style>

<script>
  function initPlatformBand() {
    const section = document.querySelector<HTMLElement>("section.platform");
    if (!section || section.dataset.platformBound === "true") return;
    section.dataset.platformBound = "true";
    const stage = section.querySelector<HTMLElement>("[data-sync]")!;
    const line = stage.querySelector<SVGPathElement>(".sync-line")!;
    const dot = stage.querySelector<SVGCircleElement>(".sync-dot")!;

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      // End state, no motion: the same card outlined on both screens.
      stage.classList.add("p-on", "w-on");
      return;
    }

    section.classList.add("animate");
    const len = line.getTotalLength();
    const CYCLE = 3200;
    let onScreen = false;
    let raf = 0;
    let start = 0;

    // Phone outline (0 to 18%), marker travels (15% to 60%), browser outline
    // (62% to 92%), then a short rest.
    const frame = (t: number) => {
      if (!onScreen) {
        raf = 0;
        return;
      }
      if (!start) start = t;
      const k = ((t - start) % CYCLE) / CYCLE;
      stage.classList.toggle("p-on", k < 0.18);
      stage.classList.toggle("w-on", k > 0.62 && k < 0.92);
      const m = Math.min(1, Math.max(0, (k - 0.15) / 0.45));
      const eased = m < 0.5 ? 2 * m * m : 1 - Math.pow(-2 * m + 2, 2) / 2;
      const pt = line.getPointAtLength(eased * len);
      dot.setAttribute("cx", String(pt.x));
      dot.setAttribute("cy", String(pt.y));
      dot.style.opacity = k > 0.12 && k < 0.64 ? "1" : "0";
      raf = requestAnimationFrame(frame);
    };

    new IntersectionObserver(
      ([entry]) => {
        onScreen = entry.isIntersecting;
        if (onScreen) {
          section.classList.add("visible");
          if (!raf) {
            start = 0;
            raf = requestAnimationFrame(frame);
          }
        }
      },
      { threshold: 0.25 },
    ).observe(stage);
  }

  initPlatformBand();
  document.addEventListener("astro:page-load", initPlatformBand);
</script>
