---
import WebAppBadge from "../common/WebAppBadge.astro";
const APP_STORE_URL =
  "https://apps.apple.com/ca/app/unify-newcomer-support/id6754875762";
---

<section class="platform">
  <div class="platform-inner">
    <div class="platform-grid">
      <div class="platform-text">
        <span class="platform-eyebrow">Web + Mobile</span>
        <h2 class="platform-heading">One platform. Every device.</h2>
        <p class="platform-desc">
          Start on the web, pick up on your phone - your checklist, lessons,
          and community circle stay perfectly in sync, wherever you are.
        </p>
        <div class="platform-cta-row">
          <WebAppBadge />
          <a
            href={APP_STORE_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="platform-badge-link"
            aria-label="Download Unify on the App Store"
          >
            <img
              src="/assets/app-store-badge-en.svg"
              alt="Download on the App Store"
              class="platform-badge"
            />
          </a>
        </div>
        <p class="platform-proof">
          <span class="platform-proof-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8" />
              <path d="M21 3v5h-5" />
              <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16" />
              <path d="M3 21v-5h5" />
            </svg>
          </span>
          <span class="platform-proof-text">Sign in once - <strong>one free account</strong> works across web and mobile.</span>
        </p>
      </div>

      <div class="platform-visual">
        <div class="platform-browser">
          <div class="browser-bar" aria-hidden="true">
            <span class="browser-dot" style="background:#ff5f57"></span>
            <span class="browser-dot" style="background:#febc2e"></span>
            <span class="browser-dot" style="background:#28c840"></span>
            <span class="browser-url">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 1a5 5 0 00-5 5v3H6a2 2 0 00-2 2v9a2 2 0 002 2h12a2 2 0 002-2v-9a2 2 0 00-2-2h-1V6a5 5 0 00-5-5zm3 8H9V6a3 3 0 016 0v3z" />
              </svg>
              app.unifysocial.ca
            </span>
          </div>
          <div class="browser-shot-wrap">
            <img
              src="/assets/screenshots/web/learn-dashboard.avif"
              alt="Unify web app - Learn dashboard at app.unifysocial.ca"
              class="browser-shot"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>

        <div class="platform-phone-wrap">
          <img
            src="/assets/screenshots/learn-hero.avif"
            alt="Unify mobile app - the same Learn screen, synced from the web"
            class="platform-phone"
            loading="lazy"
            decoding="async"
          />
          <span class="sync-badge" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8" />
              <path d="M21 3v5h-5" />
              <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16" />
              <path d="M3 21v-5h5" />
            </svg>
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .platform {
    background-color: #ffffff;
    padding: 3.5rem 0;
  }

  /* Container matches the rest of the site (Journey/Partners use
     max-w-layout = 1600px with px-6 / desktop:px-16) so the band's edges
     line up with the Core Features content below it. */
  .platform-inner {
    max-width: var(--spacing-layout);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .platform-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
    padding-top: clamp(2rem, 5vw, 3.25rem);
    border-top: 1px solid rgba(23, 22, 22, 0.1);
    overflow: visible;
  }

  /* Scroll-reveal - hidden state gated behind the JS-set data attribute so the
     static / no-JS render shows the full content. */
  .platform[data-platform-bound="true"] .platform-grid {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.8s var(--ease-out),
      transform 0.8s var(--ease-out);
  }
  .platform[data-platform-bound="true"].visible .platform-grid {
    opacity: 1;
    transform: translateY(0);
  }

  .platform-eyebrow {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(0.9375rem, 1.2vw, 1.125rem);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-brand);
  }

  .platform-heading {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 4.6vw, 3rem);
    line-height: 1.02;
    letter-spacing: var(--tracking-tight);
    color: var(--color-ink);
    margin: 0.6rem 0 0;
    text-wrap: balance;
  }

  .platform-desc {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--color-muted);
    margin: 1rem 0 0;
    max-width: 36rem;
  }

  .platform-cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .platform-badge-link {
    display: inline-block;
    transition:
      transform 0.2s var(--ease-out),
      filter 0.2s var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .platform-badge-link:hover {
      transform: translateY(-2px) scale(1.03);
      filter: drop-shadow(0 6px 16px rgba(23, 22, 22, 0.15));
    }
  }
  .platform-badge {
    height: 52px;
    width: auto;
    display: block;
  }

  /* Sync proof line */
  .platform-proof {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    margin: 1.75rem 0 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.0625rem;
    line-height: 1.4;
    color: var(--color-text);
  }
  .platform-proof-text strong {
    font-weight: 700;
    color: var(--color-ink);
  }
  .platform-proof-icon {
    display: inline-flex;
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--color-brand);
  }
  .platform-proof-icon svg {
    width: 20px;
    height: 20px;
    display: block;
  }

  /* ── Device cluster ── */
  .platform-visual {
    position: relative;
    width: 100%;
  }

  .platform-browser {
    position: relative;
    z-index: 1;
    width: 100%;
    background-color: #ffffff;
    border: 1px solid rgba(23, 22, 22, 0.08);
    border-radius: 14px;
    overflow: hidden;
    box-shadow:
      0 1px 1px rgba(23, 22, 22, 0.04),
      0 28px 56px -22px rgba(23, 22, 22, 0.4);
  }

  .browser-bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    height: 38px;
    padding: 0 0.85rem;
    background-color: #f1f1f1;
    border-bottom: 1px solid #e4e4e4;
  }

  .browser-dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .browser-url {
    flex: 1;
    margin-left: 0.5rem;
    max-width: 280px;
    height: 23px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    background-color: #ffffff;
    border: 1px solid #e4e4e4;
    border-radius: 7px;
    font-family: var(--font-display);
    font-size: 0.75rem;
    color: var(--color-muted);
    white-space: nowrap;
  }
  .browser-url svg {
    width: 10px;
    height: 10px;
    opacity: 0.5;
  }

  .browser-shot-wrap {
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }
  .browser-shot {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }

  /* Phone + sync badge share a positioning wrapper so the badge always
     sits at the phone's top-left corner - the junction with the browser. */
  .platform-phone-wrap {
    position: absolute;
    right: 0;
    bottom: -2rem;
    width: 32%;
    max-width: 150px;
    z-index: 2;
  }
  .platform-phone {
    width: 100%;
    height: auto;
    display: block;
    filter: drop-shadow(0 18px 28px rgba(23, 22, 22, 0.28));
  }

  .sync-badge {
    position: absolute;
    top: 8%;
    left: -18px;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background-color: #ffffff;
    border: 1px solid rgba(23, 22, 22, 0.08);
    box-shadow: 0 6px 16px -4px rgba(23, 22, 22, 0.25);
    display: grid;
    place-items: center;
    color: var(--color-brand);
  }
  .sync-badge svg {
    width: 19px;
    height: 19px;
    display: block;
  }
  .sync-badge::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid var(--color-brand);
    animation: sync-pulse 2.6s var(--ease-out) infinite;
  }

  @keyframes sync-pulse {
    0% {
      transform: scale(1);
      opacity: 0.5;
    }
    70%,
    100% {
      transform: scale(1.7);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .platform[data-platform-bound="true"] .platform-grid {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .sync-badge::after {
      animation: none;
    }
  }

  /* ── Tablet+ ── */
  @media (min-width: 810px) {
    .platform {
      padding: 4.5rem 0;
    }
    .platform-grid {
      grid-template-columns: 1.05fr 1fr;
      gap: 3rem;
    }
    .platform-phone-wrap {
      bottom: -2.5rem;
      width: 30%;
      max-width: 172px;
    }
  }

  /* ── Desktop ── (≥1400px: match Journey's px-16 gutter) */
  @media (min-width: 1400px) {
    .platform-inner {
      padding: 0 4rem;
    }
    .platform-grid {
      grid-template-columns: 1.2fr 1fr;
      gap: 4.5rem;
    }
    .platform-phone-wrap {
      max-width: 188px;
      bottom: -3rem;
    }
    .sync-badge {
      width: 44px;
      height: 44px;
      left: -22px;
    }
    .sync-badge svg {
      width: 22px;
      height: 22px;
    }
  }
</style>

<script>
  function initPlatformBand() {
    const section = document.querySelector<HTMLElement>("section.platform");
    if (!section || section.dataset.platformBound === "true") return;
    section.dataset.platformBound = "true";

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduce) {
      section.classList.add("visible");
      return;
    }

    const observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            section.classList.add("visible");
            obs.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 },
    );
    observer.observe(section);
  }

  document.addEventListener("astro:page-load", initPlatformBand);
</script>
