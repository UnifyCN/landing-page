---
const faqs: { q: string; a: string }[] = [
  {
    q: "What is Unify?",
    a: `<p>Unify is a Canadian platform and community designed to help newcomers and international students navigate life in Canada.</p>
<p>It brings practical settlement resources, career guidance, and in-person events into one place — helping you understand systems that are often confusing:</p>
<ul>
  <li>Banking and taxes</li>
  <li>Housing and healthcare</li>
  <li>Internships and job searching</li>
  <li>Settling into Canadian culture</li>
</ul>
<p>Beyond information, Unify is a community. Meet other people who are new to Canada, connect with peers facing similar challenges, and ask questions in a supportive space — not just a resource platform, but somewhere to build relationships and grow together.</p>`,
  },
  {
    q: "Who is Unify best for?",
    a: `<p>Unify is best for:</p>
<ul>
  <li>International students studying in Canada</li>
  <li>Recent immigrants and permanent residents</li>
  <li>First-generation Canadians</li>
  <li>Newcomers preparing to move to Canada</li>
  <li>Students looking for internships and entry-level jobs</li>
</ul>
<p>If you are new to Canada and unsure how things work, Unify is designed specifically for you.</p>`,
  },
  {
    q: "How do I connect with other newcomers on Unify?",
    a: `<p>Unify offers multiple ways to connect with others who are also new to Canada:</p>
<ul class="faq-feature-list">
  <li><strong>Community Events and Workshops</strong><span>In-person and virtual events for networking, learning, and peer connection — career workshops, newcomer panels, skill-building sessions, and social meetups.</span></li>
  <li><strong>Discussion Forum</strong><span>A community space to ask questions, share experiences, and get advice on housing, banking, internships, or navigating Canadian culture.</span></li>
  <li><strong>Interest-Based Groups</strong><span>Smaller communities organized around shared interests, career goals, industries, cultural backgrounds, or life stages.</span></li>
  <li><strong>Unify Circles</strong><span>Small-group matching that connects you with up to three other newcomers who share your background and arrived around the same time — placed together in a private group chat.</span></li>
</ul>
<p>Together, these make Unify more than a resource platform — it's an active community where newcomers build friendships and grow alongside others navigating life in Canada.</p>`,
  },
  {
    q: "What workshops does Unify offer, and how can I join one?",
    a: `<p>Unify offers practical, newcomer-focused workshops designed to help immigrants and international students navigate life in Canada.</p>
<p>Workshop topics include:</p>
<ul>
  <li>Navigating your first months in Canada</li>
  <li>Understanding the Canadian education system for newcomer parents</li>
  <li>Information sessions for international students</li>
  <li>Study permits and co-op eligibility guidance</li>
  <li>Resume building for the Canadian job market</li>
  <li>Financial literacy for newcomers</li>
  <li>Understanding Canadian workplace culture</li>
</ul>
<p>Workshops are offered through campus partnerships and community collaborations. Users can join by registering through the Unify website or Eventbrite when new sessions are announced. In the coming months, recorded workshop sessions will be uploaded to YouTube so Canadian newcomers can access the material even if they are unable to attend live.</p>`,
  },
  {
    q: "Is Unify free to use?",
    a: `<p>Yes. Unify is completely free. No credit card, no subscription.</p>`,
  },
];
---

<section class="faq-wrap">
  <div class="faq-inner">
    <header class="faq-header">
      <span class="faq-eyebrow">FAQ</span>
      <h2 class="faq-title">Frequently Asked Questions</h2>
    </header>

    <div class="faq-list">
      {
        faqs.map((item) => (
          <details class="faq-item">
            <summary class="faq-summary">
              <span class="faq-question">{item.q}</span>
              <span class="faq-toggle" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M9 3.75V14.25" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                  <path d="M3.75 9H14.25" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                </svg>
              </span>
            </summary>
            <div class="faq-answer-wrap">
              <div class="faq-answer" set:html={item.a} />
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style is:global>
  .faq-wrap {
    background-color: #ffffff;
    padding: 5rem 0 6rem;
    position: relative;
    overflow: hidden;
  }

  .faq-inner {
    max-width: 920px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .faq-header {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .faq-eyebrow {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.8125rem;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-text);
    background-color: #f3efe6;
    padding: 0.45rem 1.05rem;
    border-radius: 999px;
    line-height: 1;
  }

  .faq-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.25rem, 6vw, 4.25rem);
    line-height: 1.05;
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
    margin: 0;
    text-wrap: balance;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .faq-item {
    background-color: #ffffff;
    border: 1px solid rgba(23, 22, 22, 0.10);
    border-radius: 18px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .faq-item[open] {
    border-color: rgba(23, 22, 22, 0.18);
    box-shadow: 0 6px 22px -16px rgba(23, 22, 22, 0.18);
  }

  .faq-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 1.25rem 1.25rem 1.25rem 1.5rem;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .faq-item:hover {
      border-color: rgba(23, 22, 22, 0.20);
    }
  }

  .faq-question {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.0625rem;
    line-height: 1.35;
    color: var(--color-text);
    text-wrap: balance;
  }

  /* Plus / close toggle button */
  .faq-toggle {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    background-color: var(--color-text);
    color: #ffffff;
    border-radius: 10px;
    transition: transform 0.32s var(--ease-out), background-color 0.2s ease;
  }

  details[open] .faq-toggle {
    transform: rotate(45deg);
    background-color: var(--color-brand-red);
  }

  /* Animated answer wrapper using JS-driven max-height */
  .faq-answer-wrap {
    overflow: hidden;
    max-height: 0;
    opacity: 0;
    transition: max-height 0.4s var(--ease-out), opacity 0.28s ease;
  }

  .faq-answer-wrap.is-open {
    opacity: 1;
  }

  .faq-answer {
    padding: 0.25rem 1.5rem 1.5rem 1.5rem;
    max-width: 760px;
  }

  .faq-answer p {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-muted);
    margin: 0 0 0.875rem;
  }

  .faq-answer p:last-child {
    margin-bottom: 0;
  }

  .faq-answer ul {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .faq-answer ul li {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-muted);
    padding-left: 1.5rem;
    position: relative;
  }

  .faq-answer ul li::before {
    content: "";
    position: absolute;
    left: 0.25rem;
    top: 0.65em;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 999px;
    background-color: var(--color-brand-red);
  }

  /* Feature-list variant: bold label + description block */
  .faq-answer ul.faq-feature-list {
    gap: 0.85rem;
    margin: 0 0 1.25rem;
  }

  .faq-answer ul.faq-feature-list li {
    padding-left: 1.5rem;
    line-height: 1.55;
  }

  .faq-answer ul.faq-feature-list li strong {
    display: block;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--color-text);
    margin-bottom: 0.2rem;
  }

  .faq-answer ul.faq-feature-list li span {
    display: block;
    color: var(--color-muted);
  }

  .faq-answer ul.faq-feature-list li::before {
    top: 0.55em;
  }

  .faq-answer strong {
    font-weight: 600;
    color: var(--color-text);
  }

  @media (min-width: 810px) {
    .faq-wrap {
      padding: 6.5rem 0 7.5rem;
    }

    .faq-inner {
      padding: 0 2.5rem;
      gap: 3rem;
    }

    .faq-summary {
      padding: 1.5rem 1.5rem 1.5rem 1.875rem;
    }

    .faq-question {
      font-size: 1.125rem;
    }

    .faq-toggle {
      width: 2.5rem;
      height: 2.5rem;
      border-radius: 12px;
    }

    .faq-answer {
      padding: 0.25rem 1.875rem 1.75rem 1.875rem;
    }

    .faq-answer p,
    .faq-answer ul li {
      font-size: 1rem;
    }
  }

  @media (min-width: 1400px) {
    .faq-wrap {
      padding: 8rem 0 9rem;
    }

    .faq-inner {
      gap: 3.5rem;
    }
  }
</style>

<script>
  function initFAQ() {
    document.querySelectorAll<HTMLDetailsElement>('.faq-item').forEach(details => {
      if (details.dataset.faqBound === 'true') return;
      details.dataset.faqBound = 'true';

      const summary = details.querySelector('summary')!;
      const wrap = details.querySelector<HTMLElement>('.faq-answer-wrap')!;

      summary.addEventListener('click', e => {
        e.preventDefault();
        const isOpen = details.hasAttribute('open');

        if (isOpen) {
          wrap.style.maxHeight = wrap.scrollHeight + 'px';
          wrap.classList.remove('is-open');
          requestAnimationFrame(() => {
            wrap.style.maxHeight = '0px';
          });
          wrap.addEventListener('transitionend', () => {
            details.removeAttribute('open');
          }, { once: true });
        } else {
          details.setAttribute('open', '');
          wrap.style.maxHeight = wrap.scrollHeight + 'px';
          wrap.classList.add('is-open');
          wrap.addEventListener('transitionend', () => {
            wrap.style.maxHeight = 'none';
          }, { once: true });
        }
      });
    });
  }

  document.addEventListener('astro:page-load', initFAQ);
</script>
