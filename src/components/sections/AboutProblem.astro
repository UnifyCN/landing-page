---
// About page, "The Problem": the stats layout from about version A. Each
// problem leads with the figure it cites, set large beside its text and
// source; "No clear roadmap" has no figure, so it gets a broken dotted route.
const cards = [
  {
    stat: "62%",
    title: "Scattered information",
    body: "62% of newly arrived newcomers report struggling to find the settlement resources they need. With government sites, Reddit threads, and WhatsApp chats all giving different answers, it's hard to know what's current or relevant, whether you're looking for help with housing, banking, jobs, or your SIN number.",
    source: "Statistics Canada, General Social Survey on Social Identity, 2020",
  },
  {
    stat: "70%",
    title: "Doing it alone",
    body: "Starting over in a new country is hard enough. Doing it without a supportive newcomer community to lean on makes it even more overwhelming. 70% of newcomers and international students in Canada struggle to adapt because of cultural differences and language barriers.",
    source: "Canadian Index for Measuring Integration",
  },
  {
    stat: null,
    title: "No clear roadmap",
    body: "Without step by step guidance, it's easy to waste time, miss IRCC deadlines, or make costly mistakes on your newcomer journey in Canada.",
    source: null,
  },
];
---

<section class="ap" aria-labelledby="ap-heading">
  <div class="ap-inner">
    <p class="ap-pill">The Problem</p>
    <h2 class="ap-headline" id="ap-heading">
      <span class="ap-headline-strong">Settling in Canada</span>
      <span class="ap-headline-muted">feels harder than it should</span>
    </h2>
    <p class="ap-sub">
      Moving to a new country is more than paperwork. It's rebuilding your life from scratch. Yet most newcomers run into three avoidable problems:
    </p>

    <ol class="ap-grid" role="list">
      {cards.map((card) => (
        <li class="ap-card">
          {card.stat ? (
            <p class="ap-stat" aria-hidden="true">{card.stat}</p>
          ) : (
            <svg class="ap-noroute" viewBox="0 0 200 80" aria-hidden="true">
              <path d="M6 60 C 40 10, 70 70, 100 40" />
              <path d="M128 30 C 150 12, 170 50, 194 20" />
            </svg>
          )}
          <div class="ap-card-text">
            <h3 class="ap-card-title">{card.title}</h3>
            <p class="ap-card-body">{card.body}</p>
            {card.source && <p class="ap-card-source">Source: {card.source}</p>}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .ap {
    background-color: #ffffff;
    padding: 4.5rem 0;
  }

  .ap-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .ap-pill {
    margin: 0 0 1rem;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #b5391c;
  }

  .ap-headline {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.2rem, 5vw, 4rem);
    line-height: 1.02;
    letter-spacing: var(--tracking-display);
    text-wrap: balance;
  }

  .ap-headline-strong {
    color: var(--color-text);
  }

  .ap-headline-muted {
    color: #8a847e;
  }

  .ap-sub {
    margin: 1.25rem 0 0;
    max-width: 56ch;
    font-family: var(--font-display);
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .ap-grid {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
  }

  .ap-card {
    display: grid;
    grid-template-columns: minmax(0, 0.42fr) minmax(0, 1fr);
    gap: 1.5rem 3rem;
    align-items: center;
    padding: 2rem 0;
    border-top: 1px solid rgba(23, 22, 22, 0.1);
  }

  .ap-stat {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(3.5rem, 9vw, 7.5rem);
    line-height: 0.85;
    letter-spacing: -0.06em;
    color: var(--color-text);
  }

  .ap-noroute {
    width: min(100%, 180px);
    overflow: visible;
  }

  .ap-noroute path {
    fill: none;
    stroke: #e2532a;
    stroke-width: 5;
    stroke-linecap: round;
    stroke-dasharray: 2 12;
  }

  .ap-card-title {
    margin: 0 0 0.5rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    letter-spacing: -0.03em;
    color: var(--color-text);
  }

  .ap-card-body {
    margin: 0;
    max-width: 60ch;
    font-family: var(--font-display);
    line-height: 1.65;
    color: var(--color-muted);
  }

  .ap-card-source {
    margin: 0.75rem 0 0;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    color: #6b6763;
  }

  @media (max-width: 700px) {
    .ap-card {
      grid-template-columns: 1fr;
      gap: 0.75rem;
      align-items: start;
    }
  }

  @media (min-width: 810px) {
    .ap-inner {
      padding: 0 3rem;
    }
  }
</style>
