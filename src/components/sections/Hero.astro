---
import WebAppBadge from "../common/WebAppBadge.astro";
import StoreBadges from "../common/StoreBadges.astro";

const avatars = [
  { initials: "JP", color: "#D4A948" },
  { initials: "MA", color: "#E47793" },
  { initials: "LO", color: "#6E54B8" },
  { initials: "RN", color: "#D84A6E" },
  { initials: "+", color: "#D4B148" },
];
import { HERO_SIZES, HERO_SRCSET } from "../../lib/hero-image";
import { webpFallback } from "../../lib/image-fallback";
import { APP_RATING, APP_RATING_COUNT_LABEL } from "../../lib/app-rating";
---

<section class="hero">
  <div class="hero-inner">
    <div class="hero-text">
      <div class="hero-rating" aria-label={`Rated ${APP_RATING.value} out of 5 by ${APP_RATING_COUNT_LABEL} newcomers`}>
        <span class="hero-stars" aria-hidden="true">
          {[...Array(5)].map(() => (
            <svg viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
              <path d="M10 1.5l2.62 5.31 5.86.85-4.24 4.13 1 5.84L10 14.88l-5.24 2.75 1-5.84L1.52 7.66l5.86-.85L10 1.5z" />
            </svg>
          ))}
        </span>
        <span class="hero-rating-text">
          Rated <strong>{APP_RATING.value}</strong> by <strong>{APP_RATING_COUNT_LABEL}</strong> newcomers
        </span>
      </div>

      <h1 class="hero-h1">
        The all-in-one newcomer settlement platform
      </h1>

      <p class="hero-desc">
        Unify makes settling in Canada simpler, clearer, and more connected. Now
        available on iOS, Android, and web.
      </p>

      <div class="hero-cta-row">
        <WebAppBadge placement="hero" />
        <StoreBadges placement="hero" />
        <p class="hero-note">No credit card required</p>
      </div>

      <div class="hero-social">
        <div class="hero-avatars" aria-hidden="true">
          {avatars.map((a) => (
            <span class="hero-avatar" style={`background-color: ${a.color};`}>
              {a.initials}
            </span>
          ))}
        </div>
        <p class="hero-social-text">
          Join 700+ newcomers settling in Canada with Unify
        </p>
      </div>
    </div>

    <div class="hero-visual">
      <!-- Share responsive sources with the head preload to avoid duplicate downloads. -->
      <picture class="contents">
        <source type="image/avif" srcset={HERO_SRCSET} sizes={HERO_SIZES} />
        <img
          src="/assets/images/hero-web-mobile-c.webp"
          srcset={webpFallback(HERO_SRCSET)}
          sizes={HERO_SIZES}
          alt="Unify web app in a desktop browser beside the Unify iPhone app, both showing learning guides for newcomers in Canada"
          class="hero-devices"
          width="1448"
          height="1086"
          loading="eager"
          fetchpriority="high"
        />
      </picture>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    /* hero-device-in starts the devices 32px to the right; on a phone that
       made the page scroll sideways until the animation ended. clip (not
       hidden) adds no scroll container. */
    overflow-x: clip;
    background-color: #ffffff;
    padding-top: 4.5rem;
    padding-bottom: 2.5rem;
  }

  .hero-inner {
    position: relative;
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  /* ── Rating pill ── */
  .hero-rating {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.5rem 0.875rem 0.5rem 0.75rem;
    background-color: #ffffff;
    border: 1px solid rgba(23, 22, 22, 0.1);
    border-radius: 9999px;
    box-shadow: 0 1px 2px rgba(23, 22, 22, 0.04);
    margin-bottom: 1.5rem;
    opacity: 0;
    animation: hero-fade-up 0.5s var(--ease-out) 0.1s forwards;
  }

  .hero-stars {
    display: inline-flex;
    gap: 0.125rem;
    color: #F5A623;
  }

  .hero-stars svg {
    width: 14px;
    height: 14px;
    display: block;
  }

  .hero-rating-text {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--color-text);
    letter-spacing: -0.005em;
    line-height: 1;
  }

  .hero-rating-text strong {
    font-weight: 700;
  }

  /* ── Headline ── */
  .hero-h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.5rem, 7.5vw, 5.5rem);
    line-height: 1.02;
    letter-spacing: var(--tracking-display);
    color: var(--color-text);
    text-wrap: balance;
    opacity: 0;
    animation: hero-fade-up 0.6s var(--ease-out) 0.22s forwards;
  }

  .hero-h1 em {
    font-style: italic;
    font-weight: 700;
  }

  /* ── Body copy ── */
  .hero-desc {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1rem, 1.4vw, 1.1875rem);
    line-height: 1.6;
    color: var(--color-muted);
    margin: 1.5rem 0 0;
    max-width: 44ch;
    opacity: 0;
    animation: hero-fade-up 0.5s var(--ease-out) 0.36s forwards;
  }

  /* ── CTA row ── */
  .hero-cta-row {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 2rem;
    opacity: 0;
    animation: hero-fade-up 0.5s var(--ease-out) 0.46s forwards;
  }

  .hero-note {
    flex-basis: 100%;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    color: var(--color-muted);
    opacity: 0.7;
    margin: 0.25rem 0 0;
  }

  /* ── Social proof row ── */
  .hero-social {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.75rem;
    opacity: 0;
    animation: hero-fade-up 0.5s var(--ease-out) 0.56s forwards;
  }

  .hero-avatars {
    display: inline-flex;
  }

  .hero-avatar {
    width: 2rem;
    height: 2rem;
    border-radius: 9999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    font-family: var(--font-display);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    border: 2px solid #ffffff;
    box-shadow: 0 1px 2px rgba(23, 22, 22, 0.06);
  }

  .hero-avatar + .hero-avatar {
    margin-left: -0.5rem;
  }

  .hero-social-text {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    color: var(--color-muted);
    margin: 0;
    line-height: 1.4;
  }

  /* Device image */
  .hero-visual {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    opacity: 0;
    animation: hero-device-in 0.8s var(--ease-out) 0.2s forwards;
  }

  .hero-devices {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    max-width: 42rem;
    height: auto;
    object-fit: contain;
  }

  /* ── Entrance animations ── */
  @keyframes hero-fade-up {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes hero-device-in {
    from { opacity: 0; transform: translateX(32px) translateY(12px); }
    to   { opacity: 1; transform: none; }
  }

  /* ── Tablet ── */
  @media (min-width: 810px) {
    .hero {
      padding-top: 5rem;
      padding-bottom: 3rem;
    }

    .hero-inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 1.5rem;
      padding: 0 3rem;
      align-items: center;
    }

    .hero-h1 {
      font-size: clamp(2.5rem, 6vw, 5.5rem);
    }

    .hero-visual {
      justify-content: flex-start;
    }

    .hero-avatar {
      width: 2.25rem;
      height: 2.25rem;
      font-size: 0.6875rem;
    }

    .hero-social-text {
      font-size: 0.875rem;
    }
  }

  /* ── Desktop ── */
  @media (min-width: 1400px) {
    .hero {
      padding-top: 5.5rem;
      padding-bottom: 4rem;
    }

    .hero-inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 2rem;
      padding: 0 5rem;
      align-items: center;
    }

    .hero-visual {
      justify-content: flex-start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-rating,
    .hero-h1,
    .hero-desc,
    .hero-cta-row,
    .hero-social,
    .hero-visual {
      animation: none;
      opacity: 1;
    }
  }
</style>
