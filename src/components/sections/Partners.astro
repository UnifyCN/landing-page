---
import { partners } from "../../lib/partners";
---

<section class="partners bg-white py-14 desktop:py-20">
  <p class="partners-label">
    Our Partners
  </p>

  <div class="partners-track-wrapper">
    <div class="partners-track">
      {
        partners.map((p) => (
          <a href={`/partners/${p.slug}`} class="partner-logo-link">
            <img
              src={p.logo}
              alt={`${p.name} — a Unify Social partner`}
              class="partner-logo"
              loading="lazy"
              decoding="async"
            />
          </a>
        ))
      }
      {
        partners.map((p) => (
          <a href={`/partners/${p.slug}`} class="partner-logo-link" aria-hidden="true" tabindex="-1">
            <img src={p.logo} alt="" class="partner-logo" loading="lazy" decoding="async" />
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .partners-label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    line-height: 1.1;
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
    text-align: center;
    margin: 0 0 3rem;
  }

  .partners-track-wrapper {
    overflow: hidden;
    position: relative;
    mask-image: linear-gradient(
      to right,
      transparent,
      black 10%,
      black 90%,
      transparent
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      black 10%,
      black 90%,
      transparent
    );
  }

  .partners-track {
    display: flex;
    align-items: center;
    gap: 5.5rem;
    width: max-content;
    animation: marquee 40s linear infinite;
  }

  /* Pause on hover for entire track */
  @media (hover: hover) and (pointer: fine) {
    .partners-track-wrapper:hover .partners-track {
      animation-play-state: paused;
    }
  }

  .partner-logo-link {
    flex-shrink: 0;
    display: flex;
    border-radius: 6px;
  }

  .partner-logo-link:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 4px;
  }

  .partner-logo {
    height: 56px;
    width: auto;
    opacity: 0.85;
    transition: opacity 0.25s ease, transform 0.25s var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .partner-logo:hover {
      opacity: 1;
      transform: translateY(-2px);
    }
  }

  @media (min-width: 810px) {
    .partner-logo {
      height: 64px;
    }
  }

  @media (min-width: 1400px) {
    .partner-logo {
      height: 72px;
    }
  }

  @keyframes marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* Pause marquee when offscreen — saves compositor cycles when not visible */
  .partners.is-offscreen .partners-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .partners-track {
      animation: none;
    }
  }
</style>

<script>
  function initPartnersMarquee() {
    const section = document.querySelector<HTMLElement>(".partners");
    if (!section || section.dataset.partnersInit) return;
    section.dataset.partnersInit = "1";
    section.classList.add("is-offscreen");
    const observer = new IntersectionObserver(
      ([entry]) => {
        section.classList.toggle("is-offscreen", !entry.isIntersecting);
      },
      { threshold: 0 },
    );
    observer.observe(section);
  }

  document.addEventListener("astro:page-load", initPartnersMarquee);
</script>
