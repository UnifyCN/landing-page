---
import { APP_STORE_URL, webAppUrl } from "../../lib/app-links";
---

<section class="cta-wrap">
  <div class="cta-blob" aria-hidden="true">
    <img src="/assets/blobs/blob-8.svg" alt="" width="175" height="247" loading="lazy" decoding="async" />
  </div>
  <div class="cta-inner">
    <div class="cta-left">
      <p class="cta-eyebrow">Ready to get started?</p>
      <h2 class="cta-title">
        Stop guessing.<br />
        <em>Start settling.</em>
      </h2>
    </div>
    <div class="cta-right">
      <p class="cta-sub">
        Join thousands of newcomers who use Unify to navigate life in Canada — from day one to finding home.
      </p>
      <!-- Both ways in, always rendered. The web app is the filled button by
           default (desktop, Android, no JS); on iPhone html[data-platform="ios"]
           (set before first paint in BaseLayout) makes it the App Store. -->
      <div class="cta-actions">
        <a href={webAppUrl("cta-band")} class="cta-btn" data-app-cta="web">
          Open Unify in your browser
        </a>
        <a
          href={APP_STORE_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="cta-btn"
          data-app-cta="ios"
        >
          Download the App Now
        </a>
      </div>
      <p class="cta-note">Free on iPhone and in any browser. No credit card required.</p>
    </div>
  </div>
</section>

<style>
  .cta-wrap {
    position: relative;
    background-color: var(--color-ink);
    overflow: hidden;
    padding: 6rem 0 7rem;
  }

  .cta-blob {
    position: absolute;
    bottom: -20%;
    right: -10%;
    width: 55%;
    max-width: 680px;
    opacity: 0.07;
    pointer-events: none;
    user-select: none;
    filter: hue-rotate(330deg) saturate(0.4) invert(1);
  }

  .cta-blob img {
    width: 100%;
    height: auto;
  }

  .cta-inner {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    flex-direction: column;
    gap: 3rem;
    transition: opacity 0.7s var(--ease-out), transform 0.7s var(--ease-out);
  }

  body.js-ready .cta-inner {
    opacity: 0;
    transform: translateY(28px);
  }

  body.js-ready .cta-wrap.visible .cta-inner {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── Left: headline ── */
  .cta-eyebrow {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.6875rem;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-brand-red);
    margin: 0 0 1.25rem;
  }

  .cta-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(3rem, 8vw, 7rem);
    line-height: 0.92;
    letter-spacing: var(--tracking-display);
    color: #ffffff;
    margin: 0;
  }

  .cta-title em {
    font-style: italic;
    color: var(--color-brand-red);
  }

  /* ── Right: sub + CTA ── */
  .cta-right {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .cta-sub {
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.6);
    margin: 0;
    max-width: 42ch;
  }

  /* Stacked at every width, both as wide as the longer label: beside the
     headline the column is only ~250-290px (tightest at 810px and >=1400px),
     too narrow for two buttons in a row. */
  .cta-actions {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.75rem;
    width: fit-content;
    max-width: 100%;
  }

  /* Same box for both buttons (the 1.5px border is always there), so swapping
     which one is filled changes paint and order only. */
  .cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1rem;
    line-height: 1;
    letter-spacing: -0.01em;
    white-space: nowrap;
    text-decoration: none;
    padding: 1rem 1.5rem;
    border: 1.5px solid transparent;
    border-radius: var(--radius-cta);
    transition:
      transform 0.18s var(--ease-out),
      box-shadow 0.18s ease,
      border-color 0.18s ease,
      background-color 0.18s ease;
  }

  .cta-btn:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 3px;
  }

  /* Filled: the web app by default, the App Store on iPhone. */
  .cta-btn[data-app-cta="web"],
  :global(html[data-platform="ios"]) .cta-btn[data-app-cta="ios"] {
    order: 1;
    background-color: var(--color-brand-red);
    border-color: var(--color-brand-red);
    color: #ffffff;
    box-shadow: 0 4px 20px -4px rgba(216, 74, 41, 0.5);
  }

  /* Outline: the other one. */
  .cta-btn[data-app-cta="ios"],
  :global(html[data-platform="ios"]) .cta-btn[data-app-cta="web"] {
    order: 2;
    background-color: transparent;
    border-color: rgba(255, 255, 255, 0.32);
    color: #ffffff;
    box-shadow: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .cta-btn:hover {
      transform: translateY(-2px);
    }

    .cta-btn[data-app-cta="web"]:hover,
    :global(html[data-platform="ios"]) .cta-btn[data-app-cta="ios"]:hover {
      box-shadow: 0 12px 32px -6px rgba(216, 74, 41, 0.55);
    }

    .cta-btn[data-app-cta="ios"]:hover,
    :global(html[data-platform="ios"]) .cta-btn[data-app-cta="web"]:hover {
      border-color: rgba(255, 255, 255, 0.7);
      background-color: rgba(255, 255, 255, 0.06);
      box-shadow: none;
    }
  }

  .cta-btn:active {
    transform: scale(0.97);
  }

  .cta-note {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.35);
    margin: 0;
  }

  /* ── Phone ── */
  @media (max-width: 479px) {
    .cta-wrap {
      padding: 4rem 0 5rem;
    }

    .cta-inner {
      padding: 0 1.25rem;
    }

    .cta-title {
      font-size: clamp(2.25rem, 12vw, 3rem);
    }
  }

  /* ── Tablet ── */
  @media (min-width: 810px) {
    .cta-wrap {
      padding: 7rem 0 8rem;
    }

    .cta-inner {
      padding: 0 3rem;
      flex-direction: row;
      align-items: flex-start;
      /* Fluid so the button column keeps ~17rem next to the headline at 810px. */
      gap: clamp(2rem, 4vw, 4rem);
    }

    .cta-left {
      flex: 0 0 auto;
    }

    .cta-right {
      flex: 1;
      justify-content: flex-end;
      padding-top: 0.5rem;
    }
  }

  /* ── Desktop ── */
  @media (min-width: 1400px) {
    .cta-wrap {
      padding: 8.5rem 0 9.5rem;
    }

    .cta-inner {
      padding: 0 5rem;
      gap: 3rem;
    }

    .cta-btn {
      font-size: 1.0625rem;
      padding: 1.125rem 1.75rem;
    }
  }
</style>

<script>
  function initCtaBand() {
    const section = document.querySelector<HTMLElement>(".cta-wrap");
    if (!section || section.classList.contains("visible")) return;

    // If the section is already in view on bind (short pages, navigation
    // landing past it, etc.), reveal immediately. Otherwise observe.
    const rect = section.getBoundingClientRect();
    const inView =
      rect.top < window.innerHeight * 0.88 && rect.bottom > 0;
    if (inView) {
      section.classList.add("visible");
      return;
    }

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          section.classList.add("visible");
          observer.disconnect();
        }
      },
      { threshold: 0.12 },
    );
    observer.observe(section);
  }

  document.addEventListener("astro:page-load", initCtaBand);
</script>
