---
// Partner events as an agenda (This week / Next week / month), with topic and
// partner chips, and a sidebar calendar that is the same date system.
//
// Everything is server-rendered; the island only toggles visibility, so the
// full list works without JS. Filters come from ?genre=&partner=&day= (the
// island writes them back), and the canonical stays /events.
import EventCard from "./EventCard.astro";
import { groupAgenda, pacificDayKey, partnerLabel } from "../../lib/events/format";
import { getPartnerBySlug } from "../../lib/partners";
import type { EventView } from "../../lib/events/types";

interface Props {
  events: EventView[];
  initial: { genre: string | null; partner: string | null; day: string | null };
}

const { events, initial } = Astro.props;
const PAGE_SIZE = 15;

const now = new Date();
const groups = groupAgenda(events, now);

const countBy = (key: "genre" | "partnerSlug") =>
  events.reduce<Record<string, number>>((acc, e) => {
    const k = e[key];
    if (k) acc[k] = (acc[k] ?? 0) + 1;
    return acc;
  }, {});
const genreCounts = countBy("genre");
const partnerCounts = countBy("partnerSlug");
const genres = Object.keys(genreCounts).sort();
const partnerChips = Object.entries(partnerCounts)
  .sort((a, b) => b[1] - a[1])
  .map(([slug]) => getPartnerBySlug(slug))
  .filter((p) => p !== undefined);
const chipName = partnerLabel;

// Ignore params that match nothing, so a stale link never renders an empty page.
const genre = initial.genre && genreCounts[initial.genre] ? initial.genre : null;
const partner = initial.partner && partnerCounts[initial.partner] ? initial.partner : null;
const eventDays = new Set(events.map((e) => e.dayKey));
const day = initial.day && eventDays.has(initial.day) ? initial.day : null;

const matches = (e: EventView) =>
  (!genre || e.genre === genre) && (!partner || e.partnerSlug === partner) && (!day || e.dayKey === day);
const visibleIds = new Set(events.filter(matches).slice(0, PAGE_SIZE).map((e) => e.id));
const matchCount = events.filter(matches).length;

// Sidebar partners: every partner the crawler maps to, busiest first.
const EVENT_PARTNER_SLUGS = [
  "sfu",
  "burnaby-neighbourhood-house",
  "vancouver-public-library",
  "surrey-libraries",
  "capilano-university",
];
const sidebarPartners = EVENT_PARTNER_SLUGS.map((slug) => getPartnerBySlug(slug))
  .filter((p) => p !== undefined)
  .sort((a, b) => (partnerCounts[b.slug] ?? 0) - (partnerCounts[a.slug] ?? 0));

// Calendar: one grid per month from this month to the last event's month.
const todayKey = pacificDayKey(now);
const [ty, tm] = todayKey.split("-").map(Number);
const lastKey = events.at(-1)?.dayKey ?? todayKey;
const [ly, lm] = lastKey.split("-").map(Number);
const months: { key: string; label: string; lead: number; days: number }[] = [];
for (let y = ty, m = tm; y < ly || (y === ly && m <= lm); m === 12 ? ((m = 1), y++) : m++) {
  const first = new Date(Date.UTC(y, m - 1, 1));
  months.push({
    key: `${y}-${String(m).padStart(2, "0")}`,
    label: first.toLocaleDateString("en-CA", { month: "long", year: "numeric", timeZone: "UTC" }),
    lead: first.getUTCDay(),
    days: new Date(Date.UTC(y, m, 0)).getUTCDate(),
  });
}
const activeMonth = day ? day.slice(0, 7) : months[0].key;
const dayCounts = events.reduce<Record<string, number>>((acc, e) => {
  acc[e.dayKey] = (acc[e.dayKey] ?? 0) + 1;
  return acc;
}, {});
// One Tab stop per month (roving tabindex): the selected day, else the first
// day with events. Arrow keys move between event days inside the grid.
const rovingDay: Record<string, string> = {};
for (const key of [...eventDays].sort()) rovingDay[key.slice(0, 7)] ??= key;
if (day) rovingDay[day.slice(0, 7)] = day;
const dayLabel = (key: string) =>
  new Date(`${key}T12:00:00Z`).toLocaleDateString("en-CA", {
    weekday: "long",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  });
---

<section class="ag" id="events-agenda" aria-labelledby="agenda-heading" data-page-size={PAGE_SIZE}>
  <div class="ag-wrap">
    <p class="ag-eyebrow">Partnered events</p>
    <h2 id="agenda-heading" class="ag-title">What's coming up</h2>
    <p class="ag-sub">
      Hosted with our community partners. Filter by category or partner to find what you're
      looking for.
    </p>

    <div class="ag-layout">
      <aside class="ag-aside" aria-label="Event calendar and partners">
        <details class="ag-widget ag-cal" data-calendar data-active-month={activeMonth} open>
          <summary class="ag-cal-summary">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <rect x="2" y="3" width="12" height="11" rx="2" />
              <path d="M5 1.5v3M11 1.5v3M2 7h12" stroke-linecap="round" />
            </svg>
            <span data-cal-summary>{day ? dayLabel(day) : "Pick a date"}</span>
            <svg class="ag-cal-chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M3 4.5 6 7.5l3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </summary>
          {
            months.map((mo, i) => (
              <div class="ag-month" data-month={mo.key} hidden={mo.key !== activeMonth}>
                <div class="ag-cal-head">
                  <button type="button" class="ag-cal-nav" data-month-nav="-1" aria-label="Previous month" disabled={i === 0}>
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M8.5 3 4.5 7l4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  </button>
                  <h3 class="ag-cal-title">{mo.label}</h3>
                  <button type="button" class="ag-cal-nav" data-month-nav="1" aria-label="Next month" disabled={i === months.length - 1}>
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="m5.5 3 4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  </button>
                </div>
                <div class="ag-cal-grid" role="group" aria-label={`${mo.label}: days with events`}>
                  {["S", "M", "T", "W", "T", "F", "S"].map((d) => (
                    <span class="ag-dow" aria-hidden="true">{d}</span>
                  ))}
                  {Array.from({ length: mo.lead }, () => <span aria-hidden="true" />)}
                  {Array.from({ length: mo.days }, (_, d) => {
                    const key = `${mo.key}-${String(d + 1).padStart(2, "0")}`;
                    const n = dayCounts[key];
                    const cls = `ag-day${key === todayKey ? " is-today" : ""}${key < todayKey ? " is-past" : ""}`;
                    return n ? (
                      <button type="button" class={`${cls} has-events`} data-day-btn={key} tabindex={key === rovingDay[mo.key] ? 0 : -1} aria-pressed={String(day === key)} aria-label={`${dayLabel(key)}, ${n} event${n === 1 ? "" : "s"}`}>
                        {d + 1}
                      </button>
                    ) : (
                      <span class={cls} aria-hidden="true">{d + 1}</span>
                    );
                  })}
                </div>
              </div>
            ))
          }
          <p class="ag-cal-hint">Dots mark days with events. Pick a day to see only those.</p>
        </details>

        <div class="ag-widget ag-partners">
          <h3 class="ag-widget-title">Our event partners</h3>
          <ul role="list">
            {
              sidebarPartners.map((p) => {
                const n = partnerCounts[p.slug] ?? 0;
                return (
                  <li>
                    <a href={`/partners/${p.slug}`} class="ag-partner">
                      <span class="ag-partner-logo">
                        <img src={p.logo} alt="" loading="lazy" decoding="async" />
                      </span>
                      <span class="ag-partner-text">
                        <b>{p.name}</b>
                        <small>{n ? `${n} upcoming event${n === 1 ? "" : "s"}` : "More events soon"}</small>
                      </span>
                    </a>
                  </li>
                );
              })
            }
          </ul>
          <a href="/partners" class="ag-partners-all">
            View all partners
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </aside>

      <div class="ag-main">
        <div class="ag-filters" role="group" aria-label="Filter events">
          <div class="ag-filter">
            <span class="ag-filter-label" id="ag-topic-label">Topic</span>
            <div class="ag-chips" role="group" aria-labelledby="ag-topic-label">
              <button type="button" class="ag-chip" data-filter="genre" data-value="" aria-pressed={String(!genre)}>
                All topics
              </button>
              {
                genres.map((g) => (
                  <button type="button" class="ag-chip" data-filter="genre" data-value={g} aria-pressed={String(genre === g)}>
                    {g}
                  </button>
                ))
              }
            </div>
          </div>
          <div class="ag-filter">
            <span class="ag-filter-label" id="ag-partner-label">Partner</span>
            <div class="ag-chips" role="group" aria-labelledby="ag-partner-label">
              <button type="button" class="ag-chip" data-filter="partner" data-value="" aria-pressed={String(!partner)}>
                All partners
              </button>
              {
                partnerChips.map((p) => (
                  <button type="button" class="ag-chip" data-filter="partner" data-value={p.slug} aria-pressed={String(partner === p.slug)}>
                    {chipName(p)}
                  </button>
                ))
              }
            </div>
          </div>
        </div>

        <div class="ag-toolbar">
          <p class="ag-count" aria-live="polite" data-count>
            {matchCount} upcoming event{matchCount === 1 ? "" : "s"}
            {day && <> on {dayLabel(day)}</>}
          </p>
          <button type="button" class="ag-clear" data-clear hidden={!(genre || partner || day)}>
            Clear filters
          </button>
        </div>

        <div class="ag-list">
          {
            groups.map((g) => {
              let prevDay: string | null = null;
              const n = g.events.filter((e) => visibleIds.has(e.id)).length;
              return (
                <section class="ag-group" data-group aria-label={g.label} hidden={n === 0}>
                  <h3 class="ag-group-h">
                    <span>{g.label}</span>
                    <span class="ag-group-count" data-group-count>
                      {n ? `${n} event${n === 1 ? "" : "s"}` : ""}
                    </span>
                  </h3>
                  {g.events.map((e) => {
                    const shown = visibleIds.has(e.id);
                    const firstOfDay = shown && e.dayKey !== prevDay;
                    if (shown) prevDay = e.dayKey;
                    return (
                      <div
                        class={`ag-item${firstOfDay ? " is-first" : ""}`}
                        data-item
                        data-genre={e.genre ?? ""}
                        data-partner={e.partnerSlug ?? ""}
                        data-day={e.dayKey}
                        hidden={!shown}
                      >
                        <div class="ag-when" aria-hidden="true">
                          <b>{e.day}</b>
                          <span>{e.weekday}</span>
                        </div>
                        <EventCard event={e} variant="row" />
                      </div>
                    );
                  })}
                </section>
              );
            })
          }
          <div class="ag-empty" data-empty hidden={matchCount > 0}>
            <p>No upcoming events match these filters.</p>
            <button type="button" class="ag-clear" data-clear>Clear filters</button>
          </div>
        </div>

        <button type="button" class="ag-more" data-more hidden={matchCount <= PAGE_SIZE}>
          Show more events
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .ag {
    background: #ffffff;
    padding: clamp(3rem, 6vw, 4.5rem) 0 clamp(4rem, 8vw, 6rem);
  }

  .ag-wrap {
    max-width: 80rem;
    margin: 0 auto;
    padding-inline: clamp(1rem, 4vw, 2.5rem);
  }

  .ag-eyebrow {
    margin: 0;
    font-family: var(--font-ui);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-brand-red);
  }

  .ag-title {
    margin: 0.5rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: var(--tracking-tight);
  }

  .ag-sub {
    margin: 0.5rem 0 0;
    max-width: 40rem;
    font-family: var(--font-display);
    font-size: 1.02rem;
    line-height: 1.55;
    color: var(--color-muted);
  }

  .ag-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 20rem;
    gap: clamp(2rem, 4vw, 3rem);
    align-items: start;
    margin-top: 2rem;
  }

  /* DOM order is sidebar first (the stacked reading order); on wide screens
     the sidebar moves to the right-hand column. */
  .ag-main {
    grid-column: 1;
    grid-row: 1;
    min-width: 0;
  }

  /* Filters */
  .ag-filters {
    display: grid;
    gap: 1rem;
  }

  .ag-filter {
    display: grid;
    gap: 0.6rem;
  }

  .ag-filter-label {
    font-family: var(--font-ui);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-events-faint);
  }

  .ag-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .ag-chip {
    min-height: 2.25rem;
    padding: 0.45rem 0.95rem;
    font-family: var(--font-ui);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text);
    background: #ffffff;
    border: 1px solid var(--color-events-line);
    border-radius: 999px;
    cursor: pointer;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease,
      transform 0.12s var(--ease-out);
  }

  .ag-chip:hover {
    border-color: var(--color-events-line-strong);
    background: var(--color-events-warm);
  }

  .ag-chip:active {
    transform: scale(0.96);
  }

  .ag-chip.is-dim {
    color: var(--color-events-faint);
    border-style: dashed;
  }

  .ag-chip[aria-pressed="true"] {
    color: #ffffff;
    background: var(--color-brand-red);
    border-color: var(--color-brand-red);
  }

  .ag-chip:focus-visible,
  .ag-clear:focus-visible,
  .ag-more:focus-visible,
  .ag-day:focus-visible,
  .ag-cal-nav:focus-visible,
  .ag-partner:focus-visible {
    outline: 2px solid var(--color-brand-red);
    outline-offset: 2px;
  }

  .ag-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 1.75rem 0 0.25rem;
  }

  .ag-count {
    margin: 0;
    font-family: var(--font-ui);
    font-size: 0.875rem;
    color: var(--color-events-faint);
  }

  .ag-clear {
    padding: 0.35rem 0;
    font-family: var(--font-ui);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-brand-red);
    background: none;
    border: 0;
    cursor: pointer;
  }

  /* Agenda */
  .ag-group {
    margin-top: 1.75rem;
  }

  .ag-group[hidden] {
    display: none;
  }

  /* Sticks just under the floating navbar pill. */
  .ag-group-h {
    position: sticky;
    top: 5.75rem;
    z-index: 2;
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin: 0 0 0.75rem;
    padding: 0.6rem 0;
    background: rgba(255, 255, 255, 0.95);
    border-bottom: 1px solid var(--color-events-line);
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  /* Soft fade above the stuck heading so cards scrolling past don't show
     hard-edged text in the gap under the floating navbar. */
  .ag-group-h::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 100%;
    height: 1.75rem;
    background: linear-gradient(to top, rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0));
    pointer-events: none;
  }

  .ag-group-count {
    font-family: var(--font-ui);
    font-size: 0.82rem;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--color-events-faint);
  }

  .ag-item {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    gap: 1rem;
    padding: 0.4rem 0;
  }

  .ag-item[hidden] {
    display: none;
  }

  .ag-when {
    padding-top: 0.9rem;
    text-align: center;
    visibility: hidden;
  }

  .ag-item.is-first .ag-when {
    visibility: visible;
  }

  .ag-when b {
    display: block;
    font-family: var(--font-display);
    font-size: 1.9rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: var(--tracking-display);
  }

  .ag-when span {
    font-family: var(--font-ui);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-brand-red);
  }

  .ag-empty {
    margin-top: 1.5rem;
    padding: 3rem 1rem;
    text-align: center;
    font-family: var(--font-display);
    color: var(--color-muted);
    border: 1px dashed var(--color-events-line-strong);
    border-radius: var(--radius-card);
  }

  .ag-empty p {
    margin: 0 0 0.5rem;
  }

  .ag-more {
    display: block;
    margin: 2rem auto 0;
    padding: 0.8rem 1.4rem;
    font-family: var(--font-ui);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-ink);
    background: #ffffff;
    border: 1px solid var(--color-ink);
    border-radius: var(--radius-cta);
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .ag-more:hover {
    color: #ffffff;
    background: var(--color-ink);
  }

  /* Sidebar */
  .ag-aside {
    grid-column: 2;
    grid-row: 1;
    position: sticky;
    top: 6rem;
    display: grid;
    gap: 1rem;
  }

  .ag-widget {
    padding: 1.1rem;
    background: #ffffff;
    border: 1px solid var(--color-events-line);
    border-radius: var(--radius-card);
  }

  .ag-widget-title,
  .ag-cal-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  /* The summary only exists for phones, where the calendar starts collapsed. */
  .ag-cal-summary {
    display: none;
  }

  .ag-month[hidden] {
    display: none;
  }

  .ag-cal-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.6rem;
  }

  .ag-cal-nav {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    color: var(--color-muted);
    background: #ffffff;
    border: 1px solid var(--color-events-line);
    border-radius: 9px;
    cursor: pointer;
  }

  .ag-cal-nav:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .ag-cal-grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 2px;
    text-align: center;
  }

  .ag-dow {
    padding: 0.3rem 0;
    font-family: var(--font-ui);
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--color-events-faint);
  }

  .ag-day {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    min-height: 2.25rem;
    padding: 0;
    font-family: var(--font-ui);
    font-size: 0.85rem;
    font-weight: 500;
    color: #c4bfb9;
    background: none;
    border: 0;
    border-radius: 9px;
  }

  .ag-day.has-events {
    color: var(--color-text);
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .ag-day.has-events::after {
    content: "";
    position: absolute;
    bottom: 5px;
    left: 50%;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    border-radius: 50%;
    background: var(--color-brand-red);
  }

  .ag-day.has-events:hover {
    background: var(--color-events-warm);
  }

  .ag-day.is-today {
    box-shadow: inset 0 0 0 1px var(--color-ink);
  }

  .ag-day[aria-pressed="true"] {
    color: #ffffff;
    background: var(--color-brand-red);
  }

  .ag-day[aria-pressed="true"]::after {
    background: #ffffff;
  }

  .ag-day[aria-pressed="true"]:hover {
    background: var(--color-events-red-ink);
  }

  .ag-cal-hint {
    margin: 0.75rem 0 0;
    font-family: var(--font-ui);
    font-size: 0.76rem;
    line-height: 1.4;
    color: var(--color-events-faint);
  }

  .ag-partners ul {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
  }

  .ag-partner {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem;
    color: var(--color-text);
    text-decoration: none;
    border-radius: 12px;
    transition: background-color 0.15s ease;
  }

  .ag-partner:hover {
    background: var(--color-events-warm);
  }

  .ag-partner-logo {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    overflow: hidden;
    background: #ffffff;
    border: 1px solid var(--color-events-line);
    border-radius: 10px;
  }

  .ag-partner-logo img {
    max-width: 2.1rem;
    max-height: 2.1rem;
    object-fit: contain;
  }

  .ag-partner-text {
    min-width: 0;
  }

  .ag-partner-text b {
    display: block;
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .ag-partner-text small {
    font-family: var(--font-ui);
    font-size: 0.76rem;
    color: var(--color-events-faint);
  }

  .ag-partners-all {
    display: inline-flex;
    gap: 0.35rem;
    margin-top: 0.5rem;
    padding: 0.4rem 0.55rem;
    font-family: var(--font-ui);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-brand-red);
    text-decoration: none;
  }

  .ag-partners-all span {
    transition: transform 0.2s var(--ease-out);
  }

  .ag-partners-all:hover span {
    transform: translateX(3px);
  }

  /* Below laptop width the sidebar moves above the list: calendar first. */
  @media (max-width: 1099px) {
    .ag-layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .ag-main,
    .ag-aside {
      grid-column: auto;
      grid-row: auto;
    }

    .ag-aside {
      position: static;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
      align-items: start;
    }
  }

  @media (max-width: 700px) {
    .ag-partners {
      display: none;
    }

    .ag-cal {
      padding: 0;
    }

    .ag-cal[open] {
      padding: 0 1.1rem 1.1rem;
    }

    .ag-cal-summary {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      min-height: 3rem;
      padding: 0 1.1rem;
      font-family: var(--font-ui);
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--color-text);
      list-style: none;
      cursor: pointer;
    }

    .ag-cal-summary::-webkit-details-marker {
      display: none;
    }

    .ag-cal[open] .ag-cal-summary {
      margin: 0 -1.1rem 0.5rem;
      border-bottom: 1px solid var(--color-events-line);
    }

    .ag-cal-summary svg:first-child {
      color: var(--color-brand-red);
    }

    .ag-cal-chevron {
      margin-left: auto;
      color: var(--color-events-faint);
      transition: transform 0.2s var(--ease-out);
    }

    .ag-cal[open] .ag-cal-chevron {
      transform: rotate(180deg);
    }

    .ag-cal-summary:focus-visible {
      outline: 2px solid var(--color-brand-red);
      outline-offset: -2px;
      border-radius: var(--radius-card);
    }

    /* One swipeable row per filter instead of five wrapped rows. */
    .ag-chips {
      flex-wrap: nowrap;
      overflow-x: auto;
      margin-inline: calc(-1 * clamp(1rem, 4vw, 2.5rem));
      padding: 0.1rem clamp(1rem, 4vw, 2.5rem) 0.35rem;
      scrollbar-width: none;
      scroll-padding-inline: clamp(1rem, 4vw, 2.5rem);
    }

    .ag-chips::-webkit-scrollbar {
      display: none;
    }

    .ag-chip {
      flex: none;
      min-height: 2.75rem;
    }

    .ag-item {
      grid-template-columns: 2.75rem minmax(0, 1fr);
      gap: 0.6rem;
    }

    .ag-when b {
      font-size: 1.45rem;
    }

    .ag-group-h {
      top: 5.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ag-chip,
    .ag-partners-all span {
      transition: none;
    }
  }
</style>

<script>
  type Filters = { genre: string | null; partner: string | null; day: string | null };

  function initEventsAgenda() {
    const root = document.getElementById("events-agenda");
    if (!root || root.dataset.evBound === "true") return;
    root.dataset.evBound = "true";

    const pageSize = Number(root.dataset.pageSize) || 15;
    const items = [...root.querySelectorAll<HTMLElement>("[data-item]")];
    const groups = [...root.querySelectorAll<HTMLElement>("[data-group]")];
    const countEl = root.querySelector<HTMLElement>("[data-count]")!;
    const clearBtns = [...root.querySelectorAll<HTMLButtonElement>("[data-clear]")];
    const toolbarClear = clearBtns[0];
    const emptyEl = root.querySelector<HTMLElement>("[data-empty]")!;
    const moreBtn = root.querySelector<HTMLButtonElement>("[data-more]")!;
    const calendar = root.querySelector<HTMLDetailsElement>("[data-calendar]")!;
    const calSummary = root.querySelector<HTMLElement>("[data-cal-summary]");
    const dayBtns = [...root.querySelectorAll<HTMLButtonElement>("[data-day-btn]")];
    const phone = matchMedia("(max-width: 700px)");
    const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)");

    const params = new URLSearchParams(location.search);
    const known = (attr: string, v: string | null) =>
      v && items.some((el) => el.dataset[attr] === v) ? v : null;
    const state: Filters = {
      genre: known("genre", params.get("genre")),
      partner: known("partner", params.get("partner")),
      day: known("day", params.get("day")),
    };
    let limit = pageSize;

    const dayLabel = (key: string) =>
      new Date(`${key}T12:00:00Z`).toLocaleDateString("en-CA", {
        weekday: "long",
        month: "long",
        day: "numeric",
        timeZone: "UTC",
      });

    function apply() {
      const matches = items.filter(
        (el) =>
          (!state.genre || el.dataset.genre === state.genre) &&
          (!state.partner || el.dataset.partner === state.partner) &&
          (!state.day || el.dataset.day === state.day),
      );
      const shown = new Set(matches.slice(0, limit));
      let prevDay: string | null = null;
      for (const el of items) {
        const on = shown.has(el);
        el.hidden = !on;
        el.classList.toggle("is-first", on && el.dataset.day !== prevDay);
        if (on) prevDay = el.dataset.day ?? null;
      }
      for (const g of groups) {
        const n = g.querySelectorAll("[data-item]:not([hidden])").length;
        g.hidden = n === 0;
        const c = g.querySelector<HTMLElement>("[data-group-count]");
        if (c) c.textContent = n ? `${n} event${n === 1 ? "" : "s"}` : "";
      }

      const n = matches.length;
      countEl.textContent =
        `${n} upcoming event${n === 1 ? "" : "s"}` + (state.day ? ` on ${dayLabel(state.day)}` : "");
      const filtered = Boolean(state.genre || state.partner || state.day);
      toolbarClear.hidden = !filtered;
      emptyEl.hidden = n > 0;
      moreBtn.hidden = n <= limit;

      // Dim chips that would lead to zero results given the other filters.
      root.querySelectorAll<HTMLButtonElement>("[data-filter]").forEach((b) => {
        const key = b.dataset.filter as "genre" | "partner";
        const value = b.dataset.value || null;
        b.setAttribute("aria-pressed", String(state[key] === value));
        const probe = { ...state, [key]: value };
        const reachable = items.some(
          (el) =>
            (!probe.genre || el.dataset.genre === probe.genre) &&
            (!probe.partner || el.dataset.partner === probe.partner) &&
            (!probe.day || el.dataset.day === probe.day),
        );
        b.classList.toggle("is-dim", !reachable);
      });
      for (const b of dayBtns) b.setAttribute("aria-pressed", String(b.dataset.dayBtn === state.day));
      if (state.day) setRoving(state.day);
      if (calSummary) calSummary.textContent = state.day ? dayLabel(state.day) : "Pick a date";

      // Shareable URL; canonical stays /events (BaseLayout uses the pathname).
      const url = new URL(location.href);
      for (const [k, v] of Object.entries(state)) {
        if (v) url.searchParams.set(k, v);
        else url.searchParams.delete(k);
      }
      history.replaceState(history.state, "", url);
    }

    // One Tab stop per month: the roving day gets tabindex 0.
    function setRoving(key: string) {
      const month = key.slice(0, 7);
      for (const b of dayBtns) {
        if (b.dataset.dayBtn!.startsWith(month)) b.tabIndex = b.dataset.dayBtn === key ? 0 : -1;
      }
    }

    function showMonth(key: string) {
      calendar.dataset.activeMonth = key;
      calendar.querySelectorAll<HTMLElement>("[data-month]").forEach((m) => {
        m.hidden = m.dataset.month !== key;
      });
    }

    root.addEventListener("click", (ev) => {
      const target = ev.target as HTMLElement;

      const chip = target.closest<HTMLButtonElement>("[data-filter]");
      if (chip) {
        const key = chip.dataset.filter as "genre" | "partner";
        const value = chip.dataset.value || null;
        state[key] = state[key] === value ? null : value;
        limit = pageSize;
        apply();
        return;
      }

      const dayBtn = target.closest<HTMLButtonElement>("[data-day-btn]");
      if (dayBtn) {
        const key = dayBtn.dataset.dayBtn ?? null;
        state.day = state.day === key ? null : key;
        limit = pageSize;
        apply();
        // On stacked layouts the list sits below the calendar — bring it into view.
        if (state.day && matchMedia("(max-width: 1099px)").matches) {
          root
            .querySelector(".ag-toolbar")
            ?.scrollIntoView({ behavior: reduceMotion.matches ? "auto" : "smooth", block: "start" });
        }
        return;
      }

      const nav = target.closest<HTMLButtonElement>("[data-month-nav]");
      if (nav) {
        const months = [...calendar.querySelectorAll<HTMLElement>("[data-month]")].map((m) => m.dataset.month!);
        const i = months.indexOf(calendar.dataset.activeMonth ?? months[0]);
        const next = months[i + Number(nav.dataset.monthNav)];
        if (next) {
          showMonth(next);
          // Keep focus on the same-direction button; at the last/first month it is
          // disabled, so fall back to the other one.
          const same = calendar.querySelector<HTMLButtonElement>(
            `[data-month="${next}"] [data-month-nav="${nav.dataset.monthNav}"]:not(:disabled)`,
          );
          (same ?? calendar.querySelector<HTMLButtonElement>(`[data-month="${next}"] [data-month-nav]:not(:disabled)`))?.focus();
        }
        return;
      }

      if (target.closest("[data-clear]")) {
        state.genre = state.partner = state.day = null;
        limit = pageSize;
        apply();
        return;
      }

      if (target.closest("[data-more]")) {
        const before = new Set(items.filter((el) => !el.hidden));
        limit += pageSize;
        apply();
        // Move focus to the first newly revealed event for keyboard users.
        items
          .find((el) => !el.hidden && !before.has(el))
          ?.querySelector<HTMLAnchorElement>("a")
          ?.focus({ preventScroll: true });
      }
    });

    // Arrow keys move between days that have events: Left/Right = previous/next
    // event day, Up/Down = the nearest event day a week back/forward, Home/End =
    // first/last event day of the month. Crossing a month edge flips the month.
    const addDays = (key: string, n: number) => {
      const d = new Date(`${key}T12:00:00Z`);
      d.setUTCDate(d.getUTCDate() + n);
      return d.toISOString().slice(0, 10);
    };
    calendar.addEventListener("keydown", (ev) => {
      const current = (ev.target as HTMLElement).closest<HTMLButtonElement>("[data-day-btn]");
      if (!current) return;
      const key = current.dataset.dayBtn!;
      const keys = dayBtns.map((b) => b.dataset.dayBtn!);
      const i = keys.indexOf(key);
      const month = key.slice(0, 7);
      let target: string | undefined;
      switch (ev.key) {
        case "ArrowLeft":
          target = keys[i - 1];
          break;
        case "ArrowRight":
          target = keys[i + 1];
          break;
        case "ArrowUp": {
          const goal = addDays(key, -7);
          target = [...keys].reverse().find((k) => k <= goal) ?? keys[0];
          break;
        }
        case "ArrowDown": {
          const goal = addDays(key, 7);
          target = keys.find((k) => k >= goal) ?? keys.at(-1);
          break;
        }
        case "Home":
          target = keys.find((k) => k.startsWith(month));
          break;
        case "End":
          target = [...keys].reverse().find((k) => k.startsWith(month));
          break;
        default:
          return;
      }
      ev.preventDefault();
      if (!target || target === key) return;
      if (!target.startsWith(month)) showMonth(target.slice(0, 7));
      setRoving(target);
      dayBtns[keys.indexOf(target)].focus();
    });

    // Phones start with the calendar folded to one line ("Pick a date") so the
    // first events sit near the top; wider screens always show it.
    const syncDisclosure = () => {
      calendar.open = !phone.matches || Boolean(state.day);
    };
    phone.addEventListener("change", syncDisclosure);
    document.addEventListener("astro:before-swap", () => phone.removeEventListener("change", syncDisclosure), {
      once: true,
    });
    syncDisclosure();

    if (state.day) showMonth(state.day.slice(0, 7));
    apply();
  }

  // ClientRouter: module scripts run once, so re-init on every page load; the
  // data-ev-bound guard stops the initial load from binding twice.
  initEventsAgenda();
  document.addEventListener("astro:page-load", initEventsAgenda);
</script>
