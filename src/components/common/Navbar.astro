  .get-app-qr {
    flex-shrink: 0;
    width: 100px;
    height: 100px;
    padding: 0.5rem;
    box-sizing: content-box;
    border-radius: var(--radius-cta);
    box-shadow: inset 0 0 0 1px rgba(23, 22, 22, 0.12);
