    background-color: transparent;
    color: var(--color-ink);
    box-shadow: inset 0 0 0 1px rgba(23, 22, 22, 0.18);
  }

  /* The outlined one carries no arrow. */
  .app-ctas--stacked .app-cta[data-app-cta="store"] svg,
  :global(html[data-platform="ios"]) .app-ctas--stacked .app-cta[data-app-cta="web"] svg,
  :global(html[data-platform="android"]) .app-ctas--stacked .app-cta[data-app-cta="web"] svg {
    display: none;
  }

  :global(html[data-platform="ios"]) .app-ctas--stacked .app-cta[data-app-cta="store"] svg,
  :global(html[data-platform="android"]) .app-ctas--stacked .app-cta[data-app-cta="store"] svg {
    display: block;
  }

  /* Short phones and landscape: two CTAs and the note no longer fit under the
     links, so the menu scrolls instead of clipping them. */
  .mobile-nav {
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .mobile-cta-block {
    padding-top: 2rem;
  }

  /* Hamburger morph */
  .ham-line {
    display: block;
    width: 22px;
    height: 1.5px;
    background-color: var(--color-ink);
    border-radius: 2px;
    position: absolute;
