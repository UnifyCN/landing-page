---
import { DOWNLOAD_PATH, webAppUrl } from "../../lib/app-links";
import { playStoreUrl } from "../../lib/analytics/cta";
import StoreBadges from "./StoreBadges.astro";
import { GUIDE_HUBS } from "../../lib/guide-hubs";
import BrandLogo from "./BrandLogo.astro";

type NavChild = { label: string; href: string; note: string };
// `wide`: a long menu, laid out in two columns on desktop and folded behind a
// disclosure in the mobile overlay so it does not push everything else down.
type NavLink = { label: string; href: string; children?: NavChild[]; wide?: boolean };

// Max five top-level tabs (all five are used now; Find Services would need one
// to move). Secondary pages live in a parent's dropdown; the parent itself
// still links to its own page.
const navLinks: NavLink[] = [
  { label: "Home", href: "/" },
  {
    label: "About",
    href: "/about",
    children: [
      { label: "Partners", href: "/partners", note: "Who we build Unify with" },
      { label: "Contact", href: "/contact", note: "Questions, press, and feedback" },
    ],
  },
  { label: "Events", href: "/events" },
  {
    label: "Resources",
    href: "/resources",
    children: [
      { label: "Blog", href: "/blog", note: "Guides for settling in Canada" },
    ],
  },
  // No /guides page: the parent goes to the home page's guide grid.
  {
    label: "Guides",
    href: "/#guides",
    wide: true,
    children: GUIDE_HUBS.map((hub) => ({ label: hub.title, href: hub.href, note: hub.desc })),
  },
];

const pathname = Astro.url.pathname;

// A parent is active on its own page and on any of its children's pages.
function matchPaths(link: NavLink) {
  // "/#guides" is a section of the home page, not a path of its own.
  const own = link.href.includes("#") ? [] : [link.href];
  return [...own, ...(link.children?.map((c) => c.href) ?? [])].join(" ");
}

function isActive(paths: string) {
  return paths
    .split(" ")
    .some((href) => (href === "/" ? pathname === "/" : pathname.startsWith(href)));
}
---

<!-- Sticky wrapper. At the top of the page the navbar is a full-width bar; once
     the page scrolls it folds into a compact pill (logo + app buttons) and opens
     back up on hover, keyboard focus or a tap. Only transform and opacity animate:
     the two glass backgrounds cross-fade and the logo and buttons slide by
     offsets measured on resize (--nav-dx-l / --nav-dx-r), so nothing reflows.
     pointer-events-none so the empty part of the bar never blocks the page. -->
<div class="nav-wrap sticky top-0 z-50 pointer-events-none" id="nav-wrap" data-compact="false">
  <div class="nav-bg nav-bg--full" aria-hidden="true"></div>
  <div class="nav-bg nav-bg--pill" aria-hidden="true"></div>
  <div
    id="nav-pill"
    class="nav-pill nav-row flex items-center justify-between gap-6"
  >
    <!-- Logo — plain div, not a link -->
    <div class="nav-logo flex-shrink-0">
      <BrandLogo size={40} class="h-10 w-auto" loading="eager" />
    </div>

    <!-- Desktop nav links -->
    <nav
      class="nav-links hidden nav-full:flex items-center gap-6"
      aria-label="Main navigation"
    >
      <ul role="list" class="flex items-center gap-7 list-none m-0 p-0">
        {
          navLinks.map((link) => {
            const paths = matchPaths(link);
            const active = isActive(paths);
            const linkClass = `nav-link font-display text-nav leading-nav tracking-nav font-semibold text-ink no-underline${active ? " nav-link-active" : ""}`;
            if (!link.children) {
              return (
                <li>
                  <a
                    href={link.href}
                    data-match={paths}
                    aria-current={pathname === link.href ? "page" : undefined}
                    class={linkClass}
                  >
                    {link.label}
                  </a>
                </li>
              );
            }
            const menuId = `nav-menu-${link.label.toLowerCase()}`;
            return (
              <li class="nav-item has-menu">
                <a
                  href={link.href}
                  data-match={paths}
                  aria-current={pathname === link.href ? "page" : undefined}
                  class={linkClass}
                >
                  {link.label}
                </a>
                <button
                  type="button"
                  class="nav-caret"
                  aria-expanded="false"
                  aria-controls={menuId}
                  aria-label={`More in ${link.label}`}
                >
                  <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                    <path
                      d="M2 3.75 5 6.75l3-3"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </button>
                <div class:list={["nav-menu", { "nav-menu--wide": link.wide }]} id={menuId}>
                  <ul role="list" class="nav-menu-list list-none m-0 p-0">
                    {link.children.map((child) => (
                      <li>
                        <a
                          href={child.href}
                          data-match={child.href}
                          aria-current={pathname.startsWith(child.href) ? "page" : undefined}
                          class="nav-menu-link no-underline"
                        >
                          <span class="nav-menu-label font-display">{child.label}</span>
                          <span class="nav-menu-note font-display">{child.note}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <!-- Right side: CTA (desktop) + hamburger (mobile/tablet) -->
    <div class="nav-right flex items-center gap-3 flex-shrink-0">
<!-- Two buttons. "Get the app" opens a panel with a QR code and both store
           badges on desktop (data-platform "web"); on an iPad it is a plain
           link that BaseLayout points at the App Store, and without JS it goes
           to /download. "Open web app" goes straight in. -->
      <div class="app-ctas hidden nav-full:flex items-center" data-cta-placement="navbar">
        <div class="get-app" id="get-app">
          <a
            href={DOWNLOAD_PATH}
            class="app-cta app-cta--outline"
            id="get-app-trigger"
            data-app-cta="store"
            data-store-link
            data-android-href={playStoreUrl("navbar")}
          >
            <svg class="get-app-phone" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="6" y="2" width="12" height="20" rx="2.5"></rect>
              <path d="M11 18h2"></path>
            </svg>
            Get the app
            <svg class="get-app-caret" width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
              <path d="M2 3.75 5 6.75l3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
          <div class="get-app-panel" id="get-app-panel" role="dialog" aria-labelledby="get-app-title">
            <div class="get-app-card">
              <p class="get-app-title font-display" id="get-app-title">Get Unify on your phone</p>
              <p class="get-app-sub font-display">Scan with your phone camera. It opens the right store for your phone.</p>
              <div class="get-app-row">
                <img
                  class="get-app-qr"
                  src="/assets/qr-download.svg"
                  alt="QR code that opens Unify in your phone's app store"
                  width="100"
                  height="100"
                  loading="lazy"
                  decoding="async"
                />
                <StoreBadges lazy placement="navbar_panel" />
              </div>
              <p class="get-app-foot font-display">Free on iPhone and Android. One account everywhere.</p>
            </div>
          </div>
        </div>
        <a href={webAppUrl("navbar")} class="app-cta app-cta--filled" data-app-cta="web">
          Open web app
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>

      <!-- Below the full desktop nav: one app button in the full bar, the one for
           this device (store on a phone, web app elsewhere). It fades out when
           the bar folds into the pill. -->
      <div class="nav-mini-wrap nav-full:hidden" data-cta-placement="navbar">
        <a href={DOWNLOAD_PATH} class="nav-mini nav-mini--store" data-store-link data-android-href={playStoreUrl("navbar")}>Get the app</a>
        <a href={webAppUrl("navbar")} class="nav-mini nav-mini--web">Open web app</a>
      </div>
      <button
        id="nav-toggle"
        type="button"
        class="hamburger nav-full:hidden flex flex-col justify-center items-center w-8 h-8 bg-transparent border-0 cursor-pointer p-0 relative"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Open navigation menu"
      >
        <span class="ham-line ham-line-1"></span>
        <span class="ham-line ham-line-2"></span>
        <span class="ham-line ham-line-3"></span>
      </button>
    </div>
  </div>
</div>

<!-- Mobile full-screen overlay -->
<div
  id="mobile-nav"
  role="dialog"
  aria-modal="true"
  aria-label="Navigation menu"
  class="mobile-nav fixed inset-0 flex flex-col"
  style="z-index:60; background-color: var(--color-cream);"
>
  <!-- Top bar: logo + close -->
  <div class="px-6 h-navbar flex items-center justify-between flex-shrink-0">
    <div class="flex-shrink-0">
      <BrandLogo size={40} class="h-10 w-auto" />
    </div>
    <button
      id="nav-close"
      type="button"
      class="flex items-center justify-center w-8 h-8 bg-transparent border-0 cursor-pointer p-0 text-ink"
      aria-label="Close navigation menu"
    >
      <svg
        width="22"
        height="22"
        viewBox="0 0 22 22"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="17" y1="5" x2="5" y2="17"></line>
        <line x1="5" y1="5" x2="17" y2="17"></line>
      </svg>
    </button>
  </div>

  <!-- Links + bottom CTA -->
  <nav
    class="flex-1 flex flex-col px-10 pt-10 pb-10"
    aria-label="Mobile navigation"
  >
    <!-- Editorial left-aligned links with brand-red accent border -->
    <ul
      role="list"
      class="mobile-link-list flex flex-col gap-2 list-none m-0 p-0"
    >
      {
        navLinks.map((link, i) => (
          <li class="mobile-nav-item" style={`--i: ${i}`}>
            {link.wide && link.children ? (
              <details class="mobile-group" open={isActive(matchPaths(link))}>
                <summary class="mobile-nav-link mobile-group-summary font-display font-bold text-ink">
                  {link.label}
                  <svg width="18" height="18" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                    <path d="M2 3.75 5 6.75l3-3" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </summary>
                <ul role="list" class="mobile-sub-list list-none m-0 p-0">
                  {link.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        data-match={child.href}
                        aria-current={isActive(child.href) ? "page" : undefined}
                        class={`mobile-sub-link font-display font-semibold no-underline${isActive(child.href) ? " mobile-nav-link-active" : ""}`}
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            ) : (
            <a
              href={link.href}
              data-match={link.href}
              aria-current={isActive(link.href) ? "page" : undefined}
              class={`mobile-nav-link font-display font-bold text-ink no-underline${isActive(link.href) ? " mobile-nav-link-active" : ""}`}
            >
              {link.label}
            </a>
            )}
            {link.children && !link.wide && (
              <ul role="list" class="mobile-sub-list list-none m-0 p-0">
                {link.children.map((child) => (
                  <li>
                    <a
                      href={child.href}
                      data-match={child.href}
                      aria-current={isActive(child.href) ? "page" : undefined}
                      class={`mobile-sub-link font-display font-semibold no-underline${isActive(child.href) ? " mobile-nav-link-active" : ""}`}
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ul>

    <!-- CTA anchored to bottom -->
    <div class="mobile-nav-item mobile-cta-block mt-auto" style={`--i: ${navLinks.length}`}>
      <!-- On a phone the store link is the filled one and comes first; on
           desktop widths in a narrow window (and without JS) the web app
           leads. Only order and paint swap, never size. -->
      <div class="app-ctas app-ctas--stacked" data-cta-placement="mobile_nav">
        <a href={webAppUrl("navbar")} class="app-cta" data-app-cta="web">
          Open web app
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
        <a href={DOWNLOAD_PATH} class="app-cta" data-app-cta="store" data-store-link data-android-href={playStoreUrl("mobile_nav")}>
          Get the app
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>
      <p class="mobile-cta-note">Free on iPhone, Android, and in any browser. No credit card required.</p>
    </div>
  </nav>
</div>

<style>
  /* ── Shapeshifting bar ──
     Two glass layers with the same backdrop blur the old pill used
     (blur(14px) saturate(160%), see CLAUDE.md before raising it). Only one is
     visible at a time; the hidden one also gets visibility: hidden after its
     fade so the browser stops compositing its blur. */
  .nav-wrap {
    --nav-h: 72px;
    --nav-pill-top: 14px;
    --nav-pill-h: 58px;
    height: var(--nav-h);
  }

  .nav-bg {
    position: absolute;
    pointer-events: auto;
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.72) 0%,
      rgba(255, 255, 255, 0.5) 100%
    );
    backdrop-filter: blur(14px) saturate(160%);
    -webkit-backdrop-filter: blur(14px) saturate(160%);
    transition:
      opacity 0.32s var(--ease-out),
      transform 0.5s var(--ease-drawer),
      visibility 0s linear 0s;
  }

  /* Subtle top gloss highlight — simulates liquid refraction */
  .nav-bg::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.35) 0%,
      rgba(255, 255, 255, 0) 45%
    );
    pointer-events: none;
    mix-blend-mode: overlay;
  }

  .nav-bg--full {
    inset: 0;
    border-bottom: 1px solid rgba(23, 22, 22, 0.07);
    box-shadow: inset 0 1px 0 0 rgba(255, 255, 255, 0.8);
  }

  .nav-bg--pill {
    left: 50%;
    top: var(--nav-pill-top);
    width: var(--nav-pill-w, 320px);
    height: var(--nav-pill-h);
    margin-left: calc(var(--nav-pill-w, 320px) / -2);
    border: 1px solid rgba(255, 255, 255, 0.55);
    border-radius: var(--radius-pill);
    box-shadow:
      inset 0 1px 0 0 rgba(255, 255, 255, 0.8),
      inset 0 -1px 0 0 rgba(255, 255, 255, 0.2),
      0 14px 32px -10px rgba(23, 22, 22, 0.22),
      0 3px 10px -2px rgba(23, 22, 22, 0.1);
    opacity: 0;
    visibility: hidden;
    transform: scale(0.96);
    transition:
      opacity 0.32s var(--ease-out),
      transform 0.5s var(--ease-drawer),
      visibility 0s linear 0.32s;
  }

  .nav-row {
    position: relative;
    height: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  /* Logo, links and right-hand group slide or fade; nothing changes size. */
  .nav-logo,
  .nav-right {
    transition: transform 0.5s var(--ease-drawer);
  }

  /* Only the visible controls take pointer events. The right-hand group's own
     box is wider than the pill in the compact state (it still holds the faded
     phone button), so it must not catch taps beside the pill. */
  .nav-logo,
  .nav-right > * {
    pointer-events: auto;
  }

  .nav-links {
    pointer-events: auto;
    transition:
      opacity 0.24s var(--ease-out),
      transform 0.4s var(--ease-drawer);
  }

  .nav-mini-wrap {
    transition: opacity 0.24s var(--ease-out);
  }

  /* Compact: the pill */
  .nav-wrap[data-compact="true"] .nav-bg--full {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.32s var(--ease-out),
      visibility 0s linear 0.32s;
  }

  .nav-wrap[data-compact="true"] .nav-bg--pill {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity 0.32s var(--ease-out),
      transform 0.5s var(--ease-drawer),
      visibility 0s linear 0s;
  }

  .nav-wrap[data-compact="true"] .nav-logo {
    transform: translate3d(var(--nav-dx-l, 0px), var(--nav-dy, 0px), 0);
  }

  .nav-wrap[data-compact="true"] .nav-right {
    transform: translate3d(var(--nav-dx-r, 0px), var(--nav-dy, 0px), 0);
  }

  .nav-wrap[data-compact="true"] .nav-links {
    opacity: 0;
    transform: translate3d(0, var(--nav-dy, 0px), 0) scale(0.97);
    pointer-events: none;
  }

  .nav-wrap[data-compact="true"] .nav-mini-wrap {
    opacity: 0;
    pointer-events: none;
  }

  /* The device's own app button (BaseLayout sets html[data-platform]). */
  @media (max-width: 1023px) {
    .nav-mini-wrap {
      display: flex;
    }
  }

  .nav-mini {
    display: inline-flex;
    align-items: center;
    height: 36px;
    padding: 0 0.85rem;
    border-radius: var(--radius-btn);
    background: var(--color-ink);
    color: #ffffff;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 0.875rem;
    letter-spacing: -0.01em;
    white-space: nowrap;
    text-decoration: none;
    transition: background-color 0.2s;
  }

  .nav-mini:hover {
    background: #b83c1e;
  }

  .nav-mini:focus-visible {
    outline: 2px solid #b83c1e;
    outline-offset: 2px;
  }

  .nav-mini--store,
  :global(html[data-platform="ios"]) .nav-mini--web,
  :global(html[data-platform="android"]) .nav-mini--web {
    display: none;
  }

  :global(html[data-platform="ios"]) .nav-mini--store,
  :global(html[data-platform="android"]) .nav-mini--store {
    display: inline-flex;
  }

  @media (min-width: 1024px) {
    .nav-row {
      padding: 0 2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-bg,
    .nav-bg--pill,
    .nav-logo,
    .nav-right,
    .nav-links,
    .nav-mini-wrap,
    .nav-wrap[data-compact="true"] .nav-bg--full,
    .nav-wrap[data-compact="true"] .nav-bg--pill {
      transition: none;
    }
  }

  /* Desktop nav link — red underline grows from center on hover */
  .nav-link {
    position: relative;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    bottom: -2px;
    left: 50%;
    width: 100%;
    height: 2px;
    background: var(--color-brand-red);
    border-radius: 1px;
    transform: translateX(-50%) scaleX(0);
    transform-origin: center;
    transition: transform 0.2s ease;
  }

  .nav-link:hover::after,
  .nav-link-active::after {
    transform: translateX(-50%) scaleX(1);
  }

  /* Dropdown parent: link + caret button. The menu opens on hover (pointer
     users) or on .is-open, which the caret toggles (keyboard + touch). */
  .nav-item {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-caret {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* 24px: the WCAG 2.2 minimum target size */
    width: 1.5rem;
    height: 1.5rem;
    margin-right: -0.4rem;
    margin-left: -0.1rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--color-muted);
    cursor: pointer;
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }

  .nav-caret svg {
    transition: transform 0.24s var(--ease-out);
  }

  .nav-caret:hover,
  .nav-caret:focus-visible {
    color: var(--color-ink);
    background-color: rgba(23, 22, 22, 0.06);
  }

  .nav-caret:focus-visible {
    outline: 2px solid var(--color-brand-red);
    outline-offset: 1px;
  }

  /* padding-top bridges the gap to the pill edge so hover never drops
     while the pointer travels from the link into the panel. */
  .nav-menu {
    position: absolute;
    top: 100%;
    left: -1rem;
    padding-top: 1.35rem;
    min-width: 15.5rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition:
      opacity 0.18s var(--ease-out),
      transform 0.22s var(--ease-out),
      visibility 0s linear 0.22s;
  }

  /* Opaque on purpose: a second backdrop-filter nested inside the pill's
     would not blur the page, and it doubles the scroll-time GPU cost. */
  .nav-menu-list {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: 0.5rem;
    background: #ffffff;
    border: 1px solid rgba(23, 22, 22, 0.08);
    border-radius: var(--radius-cta);
    box-shadow:
      0 18px 40px -16px rgba(23, 22, 22, 0.24),
      0 4px 12px -4px rgba(23, 22, 22, 0.08);
  }

  @media (hover: hover) {
    .has-menu:hover .nav-menu {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
      transition:
        opacity 0.18s var(--ease-out),
        transform 0.22s var(--ease-out),
        visibility 0s linear 0s;
    }

    .has-menu:hover .nav-caret svg {
      transform: rotate(180deg);
    }
  }

  .has-menu.is-open .nav-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    transition:
      opacity 0.18s var(--ease-out),
      transform 0.22s var(--ease-out),
      visibility 0s linear 0s;
  }

  .has-menu.is-open .nav-caret svg {
    transform: rotate(180deg);
  }

  .nav-menu-link {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: 0.625rem 0.75rem;
    border-radius: 8px;
    transition: background-color 0.15s ease;
  }

  .nav-menu-link:hover,
  .nav-menu-link:focus-visible {
    background-color: rgba(216, 74, 41, 0.07);
  }

  .nav-menu-link:focus-visible {
    outline: 2px solid var(--color-brand-red);
    outline-offset: -2px;
  }

  .nav-menu-label {
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-text);
    transition: color 0.15s ease;
