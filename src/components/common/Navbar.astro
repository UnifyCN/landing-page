<script>
  // ── Shapeshifting bar ──
  // Full at the top of the page, a compact pill once scrolled, and full again
  // while the pointer is over it, keyboard focus is inside it, a menu or the
  // Get the app panel is open, or after a tap (until the next scroll).
  const COMPACT_AFTER = 24; // px of scroll before the bar folds
  let scrolledPast = false;
  let hovering = false;
  let focused = false;
  let tapped = false;
  let tapScrollY = 0;
  let frame = 0;

  function navWrap() {
    return document.getElementById("nav-wrap");
  }

  function applyState() {
    const wrap = navWrap();
    if (!wrap) return;
    const anyOpen = !!document.querySelector("#nav-pill .has-menu.is-open, #get-app.is-open");
    const compact = scrolledPast && !hovering && !focused && !tapped && !anyOpen;
    if (wrap.dataset.compact !== String(compact)) wrap.dataset.compact = String(compact);
  }

  // Offsets for the compact pill. Read in layout coordinates (offsetLeft /
  // offsetWidth ignore transforms), so measuring is the same in both states.
  function measure() {
    const wrap = navWrap();
    const row = document.getElementById("nav-pill");
    const logo = row?.querySelector<HTMLElement>(".nav-logo");
    const right = row?.querySelector<HTMLElement>(".nav-right");
    if (!wrap || !row || !logo || !right) return;
    const desktop = window.matchMedia("(min-width: 1024px)").matches;
    const toggle = document.getElementById("nav-toggle");
    const ctas = right.querySelector<HTMLElement>(".app-ctas");
    // What stays in the pill on the right: both app buttons on desktop, the
    // menu button below that.
    const keep = desktop ? ctas : toggle;
    if (!keep) return;
    const padL = 18;
    const padR = desktop ? 8 : 12;
    const gap = desktop ? 24 : 20;
    const pillW = padL + logo.offsetWidth + gap + keep.offsetWidth + padR;
    const rowW = row.clientWidth;
    const pillLeft = (rowW - pillW) / 2;
    const rightEdge = right.offsetLeft + right.offsetWidth;
    wrap.style.setProperty("--nav-pill-w", `${Math.round(pillW)}px`);
    wrap.style.setProperty("--nav-dx-l", `${Math.round(pillLeft + padL - logo.offsetLeft)}px`);
    wrap.style.setProperty("--nav-dx-r", `${Math.round(pillLeft + pillW - padR - rightEdge)}px`);
    const styles = getComputedStyle(wrap);
    const navH = parseFloat(styles.getPropertyValue("--nav-h")) || 72;
    const pillTop = parseFloat(styles.getPropertyValue("--nav-pill-top")) || 14;
    const pillH = parseFloat(styles.getPropertyValue("--nav-pill-h")) || 58;
    wrap.style.setProperty("--nav-dy", `${Math.round(pillTop + pillH / 2 - navH / 2)}px`);
  }

  // One read of scrollY per frame at most, whatever the scroll event rate.
  function updateScrollState() {
    if (frame) return;
    frame = requestAnimationFrame(() => {
      frame = 0;
      const y = window.scrollY;
      const past = y > COMPACT_AFTER;
      if (tapped && Math.abs(y - tapScrollY) > 48) tapped = false;
      if (past !== scrolledPast || !past) scrolledPast = past;
      applyState();
    });
  }

  function bindShapeshift() {
    const wrap = navWrap();
    if (!wrap) return;
    const fine = window.matchMedia("(hover: hover) and (pointer: fine)");
    let leaveTimer = 0;
    // pointerover/pointerout bubble from the visible parts (the wrapper itself
    // has pointer-events: none, so it gets no enter/leave of its own).
    wrap.addEventListener("pointerover", (e) => {
      if (e.pointerType !== "mouse" || !fine.matches) return;
      window.clearTimeout(leaveTimer);
      if (!hovering) {
        hovering = true;
        applyState();
      }
    });
    wrap.addEventListener("pointerout", (e) => {
      if (e.pointerType !== "mouse" || wrap.contains(e.relatedTarget as Node | null)) return;
      window.clearTimeout(leaveTimer);
      leaveTimer = window.setTimeout(() => {
        hovering = false;
        applyState();
      }, 180);
    });
    wrap.addEventListener("focusin", () => {
      focused = true;
      applyState();
    });
    wrap.addEventListener("focusout", (e) => {
      if (wrap.contains(e.relatedTarget as Node | null)) return;
      focused = false;
      applyState();
    });
    // Touch: a tap on the pill (not on a link or button) opens the full bar
    // until the page scrolls on or the user taps elsewhere.
    wrap.addEventListener("click", (e) => {
      if (wrap.dataset.compact !== "true") return;
      if ((e.target as Element).closest("a, button")) return;
      tapped = true;
      tapScrollY = window.scrollY;
      applyState();
    });
    document.addEventListener("click", (e) => {
      if (!tapped || wrap.contains(e.target as Node)) return;
      tapped = false;
      applyState();
    });
    // Menus and the Get the app panel keep the bar full while open.
    new MutationObserver(applyState).observe(wrap, { subtree: true, attributes: true, attributeFilter: ["class"] });
    // Re-measure when anything in the bar changes size (fonts, resize, breakpoint).
    let measureFrame = 0;
    const remeasure = () => {
      if (measureFrame) return;
      measureFrame = requestAnimationFrame(() => {
        measureFrame = 0;
        measure();
      });
    };
    const ro = new ResizeObserver(remeasure);
    ro.observe(wrap);
    wrap.querySelectorAll(".nav-logo, .nav-right, .app-ctas").forEach((el) => ro.observe(el));
    measure();
  }

  // The navbar persists across View Transitions, so the server-rendered active
  // state goes stale on client-side navigation. data-match lists every path a
  // link counts as active on (a dropdown parent includes its children's paths);
  // aria-current stays on the link whose own page this is.
  function updateActiveLinks() {
    const path = window.location.pathname;
    const onPath = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
    document
      .querySelectorAll<HTMLAnchorElement>("#nav-pill a[data-match], #mobile-nav a[data-match]")
      .forEach((a) => {
        const isActive = (a.dataset.match ?? "").split(" ").some(onPath);
        const href = a.getAttribute("href") ?? "";
        const isCurrent = a.classList.contains("nav-link") ? path === href : isActive;
        a.classList.toggle("nav-link-active", a.classList.contains("nav-link") && isActive);
        a.classList.toggle(
          "mobile-nav-link-active",
          (a.classList.contains("mobile-nav-link") || a.classList.contains("mobile-sub-link")) &&
            isActive,
        );
        if (isCurrent) {
          a.setAttribute("aria-current", "page");
        } else {
          a.removeAttribute("aria-current");
        }
      });
    // A folded mobile group opens when the current page is one of its links.
    document.querySelectorAll<HTMLDetailsElement>("#mobile-nav .mobile-group").forEach((group) => {
      group.open = group.querySelector(".mobile-nav-link-active") !== null;
    });
  }

  function closeDropdowns(except?: Element) {
    document.querySelectorAll<HTMLElement>("#nav-pill .has-menu.is-open").forEach((item) => {
      if (item === except) return;
      item.classList.remove("is-open");
      item.querySelector(".nav-caret")?.setAttribute("aria-expanded", "false");
    });
  }

  function bindDropdowns() {
    document.querySelectorAll<HTMLElement>("#nav-pill .has-menu").forEach((item) => {
      const caret = item.querySelector<HTMLButtonElement>(".nav-caret");
      caret?.addEventListener("click", () => {
        const open = !item.classList.contains("is-open");
        closeDropdowns(item);
        setGetApp(false);
        item.classList.toggle("is-open", open);
        caret.setAttribute("aria-expanded", String(open));
      });
      // Close once keyboard focus leaves the parent and its menu.
      item.addEventListener("focusout", (e) => {
        if (!item.contains(e.relatedTarget as Node | null)) closeDropdowns();
      });
    });

    document.addEventListener("click", (e) => {
      if (!(e.target as Element | null)?.closest("#nav-pill .has-menu")) closeDropdowns();
    });
  }

  // "Get the app" in the pill. On desktop (data-platform "web") it toggles the
  // download panel; on an iPad or Android tablet it stays a plain link, which
  // BaseLayout has pointed at that device's store. Read the platform on each
  // click: it is set by BaseLayout and never changes within a visit.
  const isDesktop = () => document.documentElement.dataset.platform === "web";

  function setGetApp(open: boolean) {
    const wrap = document.getElementById("get-app");
    const trigger = document.getElementById("get-app-trigger");
    if (!wrap || !trigger) return;
    wrap.classList.toggle("is-open", open);
    if (isDesktop()) trigger.setAttribute("aria-expanded", String(open));
  }

  function bindGetApp() {
    const wrap = document.getElementById("get-app");
    const trigger = document.getElementById("get-app-trigger");
    if (!wrap || !trigger) return;
    if (isDesktop()) {
      trigger.setAttribute("role", "button");
      trigger.setAttribute("aria-expanded", "false");
      trigger.setAttribute("aria-controls", "get-app-panel");
    }
    const toggle = (e: Event) => {
      if (!isDesktop()) return;
      e.preventDefault();
      closeDropdowns();
      setGetApp(!wrap.classList.contains("is-open"));
    };
    trigger.addEventListener("click", toggle);
    // role="button" means Space must work like a click, as on a <button>.
    trigger.addEventListener("keydown", (e) => {
      if (e.key === " ") toggle(e);
    });
    wrap.addEventListener("focusout", (e) => {
      if (!wrap.contains(e.relatedTarget as Node | null)) setGetApp(false);
    });
    document.addEventListener("click", (e) => {
      if (!(e.target as Element | null)?.closest("#get-app")) setGetApp(false);
    });
  }

  function openMenu() {
    const menu = document.getElementById("mobile-nav");
    const toggle = document.getElementById("nav-toggle");
    if (!menu || !toggle) return;
    menu.classList.add("is-open");
    toggle.classList.add("is-open");
    toggle.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
  }

  function closeMenu() {
    const menu = document.getElementById("mobile-nav");
    const toggle = document.getElementById("nav-toggle");
    if (!menu || !toggle) return;
    menu.classList.remove("is-open");
    toggle.classList.remove("is-open");
    toggle.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
  }

  // Bind interaction handlers exactly once. The navbar carries
  // transition:persist, so its DOM survives View Transition navigations —
  // re-binding on every page-load would leak listeners.
  function bindNavbarOnce() {
    const pill = document.getElementById("nav-pill");
    if (!pill || pill.dataset.navBound === "true") return;
    pill.dataset.navBound = "true";

    document.getElementById("nav-toggle")?.addEventListener("click", openMenu);
    document.getElementById("nav-close")?.addEventListener("click", closeMenu);

    window.addEventListener("scroll", updateScrollState, { passive: true });
    bindShapeshift();

    bindDropdowns();
    bindGetApp();

    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      if (document.getElementById("get-app")?.classList.contains("is-open")) {
        setGetApp(false);
        document.getElementById("get-app-trigger")?.focus();
      }
      const menu = document.getElementById("mobile-nav");
      if (menu?.classList.contains("is-open")) closeMenu();
      const openItem = document.querySelector<HTMLElement>("#nav-pill .has-menu.is-open");
      if (openItem) {
        closeDropdowns();
        openItem.querySelector<HTMLButtonElement>(".nav-caret")?.focus();
      }
    });
  }

  // Per-page work — must re-run on every navigation.
  function refreshNavbar() {
    updateScrollState();
    updateActiveLinks();
  }

  // Reset body overflow and close menu before every navigation.
  document.addEventListener("astro:before-preparation", () => {
    document.body.style.overflow = "";
    closeDropdowns();
    setGetApp(false);
    const menu = document.getElementById("mobile-nav");
    const toggle = document.getElementById("nav-toggle");
    if (menu) menu.classList.remove("is-open");
    if (toggle) {
      toggle.classList.remove("is-open");
      toggle.setAttribute("aria-expanded", "false");
    }
  });

  // Run immediately on initial load — this module is deferred, so the DOM is
  // already parsed. Don't wait for astro:page-load, which can fire before this
  // script has executed on a cold load and be missed.
  bindNavbarOnce();
  refreshNavbar();

  // Re-run on subsequent View Transition navigations.
  document.addEventListener("astro:page-load", () => {
    bindNavbarOnce();
    refreshNavbar();
  });
</script>
