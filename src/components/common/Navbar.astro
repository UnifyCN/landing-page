  /* Children sit indented under their parent, one step down in size */
  .mobile-sub-list {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    margin: 0.125rem 0 0.5rem 0.25rem;
  }

  .mobile-sub-link {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.3rem 0;
    font-size: clamp(1.125rem, 3.4vw, 1.375rem);
    letter-spacing: -0.02em;
    color: var(--color-muted);
    transition: color 0.15s ease;
  }

  .mobile-sub-link::before {
    content: "";
    width: 0.875rem;
    height: 1.5px;
    background: currentColor;
    opacity: 0.45;
  }

  .mobile-sub-link:hover,
  .mobile-sub-link.mobile-nav-link-active {
    color: var(--color-brand-red);
  }

  .mobile-cta-note {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    color: var(--color-muted);
    opacity: 0.6;
    margin: 0.5rem 0 0;
  }

  /* Staggered reveals */
  .mobile-nav-item {
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.28s ease,
      transform 0.28s var(--ease-out);
