---
import { APP_STORE_URL, webAppUrl } from "../../lib/app-links";
import { GUIDE_HUBS } from "../../lib/guide-hubs";

type NavChild = { label: string; href: string; note: string };
// `wide`: a long menu, laid out in two columns on desktop and folded behind a
// disclosure in the mobile overlay so it does not push everything else down.
type NavLink = { label: string; href: string; children?: NavChild[]; wide?: boolean };

// Max five top-level tabs (all five are used now; Find Services would need one
// to move). Secondary pages live in a parent's dropdown; the parent itself
// still links to its own page.
const navLinks: NavLink[] = [
  { label: "Home", href: "/" },
  {
    label: "About",
    href: "/about",
    children: [
      { label: "Partners", href: "/partners", note: "Who we build Unify with" },
      { label: "Contact", href: "/contact", note: "Questions, press, and feedback" },
    ],
  },
  { label: "Events", href: "/events" },
  {
    label: "Resources",
    href: "/resources",
    children: [
      { label: "Blog", href: "/blog", note: "Guides for settling in Canada" },
    ],
  },
  // No /guides page: the parent goes to the home page's guide grid.
  {
    label: "Guides",
    href: "/#guides",
    wide: true,
    children: GUIDE_HUBS.map((hub) => ({ label: hub.title, href: hub.href, note: hub.desc })),
  },
];

const pathname = Astro.url.pathname;

// A parent is active on its own page and on any of its children's pages.
function matchPaths(link: NavLink) {
  // "/#guides" is a section of the home page, not a path of its own.
  const own = link.href.includes("#") ? [] : [link.href];
  return [...own, ...(link.children?.map((c) => c.href) ?? [])].join(" ");
}

function isActive(paths: string) {
  return paths
    .split(" ")
    .some((href) => (href === "/" ? pathname === "/" : pathname.startsWith(href)));
}
---

<!-- Sticky wrapper — pointer-events-none so it doesn't block page content below the pill -->
<div class="sticky top-5 z-50 flex justify-center px-4 pointer-events-none">
  <div
    id="nav-pill"
    class="nav-pill pointer-events-auto flex items-center gap-6 w-auto pl-5 pr-3 py-2.5"
  >
    <!-- Logo — plain div, not a link -->
    <div class="flex-shrink-0">
      <img
        src="/assets/logo/new-unify-logo-256.png"
        alt="Unify Social"
        class="h-10 w-auto"
        loading="eager"
      />
    </div>

    <!-- Desktop nav links -->
    <nav
      class="hidden nav-full:flex items-center gap-6"
      aria-label="Main navigation"
    >
      <ul role="list" class="flex items-center gap-7 list-none m-0 p-0">
        {
          navLinks.map((link) => {
            const paths = matchPaths(link);
            const active = isActive(paths);
            const linkClass = `nav-link font-display text-nav leading-nav tracking-nav font-semibold text-ink no-underline${active ? " nav-link-active" : ""}`;
            if (!link.children) {
              return (
                <li>
                  <a
                    href={link.href}
                    data-match={paths}
                    aria-current={pathname === link.href ? "page" : undefined}
                    class={linkClass}
                  >
                    {link.label}
                  </a>
                </li>
              );
            }
            const menuId = `nav-menu-${link.label.toLowerCase()}`;
            return (
              <li class="nav-item has-menu">
                <a
                  href={link.href}
                  data-match={paths}
                  aria-current={pathname === link.href ? "page" : undefined}
                  class={linkClass}
                >
                  {link.label}
                </a>
                <button
                  type="button"
                  class="nav-caret"
                  aria-expanded="false"
                  aria-controls={menuId}
                  aria-label={`More in ${link.label}`}
                >
                  <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                    <path
                      d="M2 3.75 5 6.75l3-3"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </button>
                <div class:list={["nav-menu", { "nav-menu--wide": link.wide }]} id={menuId}>
                  <ul role="list" class="nav-menu-list list-none m-0 p-0">
                    {link.children.map((child) => (
                      <li>
                        <a
                          href={child.href}
                          data-match={child.href}
                          aria-current={pathname.startsWith(child.href) ? "page" : undefined}
                          class="nav-menu-link no-underline"
                        >
                          <span class="nav-menu-label font-display">{child.label}</span>
                          <span class="nav-menu-note font-display">{child.note}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <!-- Right side: CTA (desktop) + hamburger (mobile/tablet) -->
    <div class="flex items-center gap-3 flex-shrink-0">
<!-- Both ways in, always rendered. The web app leads by default (desktop,
           Android, no JS); on iPhone html[data-platform="ios"] (set before first
           paint in BaseLayout) swaps which one is the filled button. In the
           pill the quiet link comes first in the DOM, matching what is shown
           at desktop widths, so Tab moves left to right. -->
      <div class="app-ctas hidden nav-full:flex items-center">
        <a
          href={APP_STORE_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="app-cta"
          data-app-cta="ios"
        >
          Download Unify
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
        <a href={webAppUrl("navbar")} class="app-cta" data-app-cta="web">
          Open Unify in your browser
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>

      <button
        id="nav-toggle"
        type="button"
        class="hamburger nav-full:hidden flex flex-col justify-center items-center w-8 h-8 bg-transparent border-0 cursor-pointer p-0 relative"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Open navigation menu"
      >
        <span class="ham-line ham-line-1"></span>
        <span class="ham-line ham-line-2"></span>
        <span class="ham-line ham-line-3"></span>
      </button>
    </div>
  </div>
</div>

<!-- Mobile full-screen overlay -->
<div
  id="mobile-nav"
  role="dialog"
  aria-modal="true"
  aria-label="Navigation menu"
  class="mobile-nav fixed inset-0 flex flex-col"
  style="z-index:60; background-color: var(--color-cream);"
>
  <!-- Top bar: logo + close -->
  <div class="px-6 h-navbar flex items-center justify-between flex-shrink-0">
    <div class="flex-shrink-0">
      <img
        src="/assets/logo/new-unify-logo-256.png"
        alt="Unify Social"
        class="h-10 w-auto"
        loading="eager"
      />
    </div>
    <button
      id="nav-close"
      type="button"
      class="flex items-center justify-center w-8 h-8 bg-transparent border-0 cursor-pointer p-0 text-ink"
      aria-label="Close navigation menu"
    >
      <svg
        width="22"
        height="22"
        viewBox="0 0 22 22"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="17" y1="5" x2="5" y2="17"></line>
        <line x1="5" y1="5" x2="17" y2="17"></line>
      </svg>
    </button>
  </div>

  <!-- Links + bottom CTA -->
  <nav
    class="flex-1 flex flex-col px-10 pt-10 pb-10"
    aria-label="Mobile navigation"
  >
    <!-- Editorial left-aligned links with brand-red accent border -->
    <ul
      role="list"
      class="mobile-link-list flex flex-col gap-2 list-none m-0 p-0"
    >
      {
        navLinks.map((link, i) => (
          <li class="mobile-nav-item" style={`--i: ${i}`}>
            {link.wide && link.children ? (
              <details class="mobile-group" open={isActive(matchPaths(link))}>
                <summary class="mobile-nav-link mobile-group-summary font-display font-bold text-ink">
                  {link.label}
                  <svg width="18" height="18" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                    <path d="M2 3.75 5 6.75l3-3" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </summary>
                <ul role="list" class="mobile-sub-list list-none m-0 p-0">
                  {link.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        data-match={child.href}
                        aria-current={isActive(child.href) ? "page" : undefined}
                        class={`mobile-sub-link font-display font-semibold no-underline${isActive(child.href) ? " mobile-nav-link-active" : ""}`}
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            ) : (
            <a
              href={link.href}
              data-match={link.href}
              aria-current={isActive(link.href) ? "page" : undefined}
              class={`mobile-nav-link font-display font-bold text-ink no-underline${isActive(link.href) ? " mobile-nav-link-active" : ""}`}
            >
              {link.label}
            </a>
            )}
            {link.children && !link.wide && (
              <ul role="list" class="mobile-sub-list list-none m-0 p-0">
                {link.children.map((child) => (
                  <li>
                    <a
                      href={child.href}
                      data-match={child.href}
                      aria-current={isActive(child.href) ? "page" : undefined}
                      class={`mobile-sub-link font-display font-semibold no-underline${isActive(child.href) ? " mobile-nav-link-active" : ""}`}
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ul>

    <!-- CTA anchored to bottom -->
    <div class="mobile-nav-item mobile-cta-block mt-auto" style={`--i: ${navLinks.length}`}>
      <div class="app-ctas app-ctas--stacked">
        <a href={webAppUrl("navbar")} class="app-cta" data-app-cta="web">
          Open Unify in your browser
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
        <a
          href={APP_STORE_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="app-cta"
          data-app-cta="ios"
        >
          Download Unify
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>
      <p class="mobile-cta-note">Free on iPhone and in any browser. No credit card required.</p>
    </div>
  </nav>
</div>

<style>
  .nav-pill {
    position: relative;
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.72) 0%,
      rgba(255, 255, 255, 0.5) 100%
    );
    backdrop-filter: blur(14px) saturate(160%);
    -webkit-backdrop-filter: blur(14px) saturate(160%);
    border: 1px solid rgba(255, 255, 255, 0.55);
    border-radius: var(--radius-pill);
    box-shadow:
      inset 0 1px 0 0 rgba(255, 255, 255, 0.8),
      inset 0 -1px 0 0 rgba(255, 255, 255, 0.2),
      0 8px 24px -8px rgba(23, 22, 22, 0.14),
      0 2px 6px -2px rgba(23, 22, 22, 0.08);
    transition:
      background 0.3s ease,
      box-shadow 0.3s ease;
  }

  /* Subtle top gloss highlight — simulates liquid refraction */
  .nav-pill::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.35) 0%,
      rgba(255, 255, 255, 0) 45%
    );
    pointer-events: none;
    mix-blend-mode: overlay;
  }

  .nav-pill.is-scrolled {
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.85) 0%,
      rgba(255, 255, 255, 0.65) 100%
    );
    box-shadow:
      inset 0 1px 0 0 rgba(255, 255, 255, 0.9),
      inset 0 -1px 0 0 rgba(255, 255, 255, 0.25),
      0 14px 32px -10px rgba(23, 22, 22, 0.22),
      0 3px 10px -2px rgba(23, 22, 22, 0.1);
  }

  /* Desktop nav link — red underline grows from center on hover */
  .nav-link {
    position: relative;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    bottom: -2px;
    left: 50%;
    width: 100%;
    height: 2px;
    background: var(--color-brand-red);
    border-radius: 1px;
    transform: translateX(-50%) scaleX(0);
    transform-origin: center;
    transition: transform 0.2s ease;
  }

  .nav-link:hover::after,
  .nav-link-active::after {
    transform: translateX(-50%) scaleX(1);
  }

  /* Dropdown parent: link + caret button. The menu opens on hover (pointer
     users) or on .is-open, which the caret toggles (keyboard + touch). */
  .nav-item {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-caret {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* 24px: the WCAG 2.2 minimum target size */
    width: 1.5rem;
    height: 1.5rem;
    margin-right: -0.4rem;
    margin-left: -0.1rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--color-muted);
    cursor: pointer;
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }

  .nav-caret svg {
    transition: transform 0.24s var(--ease-out);
  }

  .nav-caret:hover,
  .nav-caret:focus-visible {
    color: var(--color-ink);
    background-color: rgba(23, 22, 22, 0.06);
  }

  .nav-caret:focus-visible {
    outline: 2px solid var(--color-brand-red);
    outline-offset: 1px;
  }

  /* padding-top bridges the gap to the pill edge so hover never drops
     while the pointer travels from the link into the panel. */
  .nav-menu {
    position: absolute;
    top: 100%;
    left: -1rem;
    padding-top: 1.35rem;
    min-width: 15.5rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition:
      opacity 0.18s var(--ease-out),
      transform 0.22s var(--ease-out),
      visibility 0s linear 0.22s;
  }

  /* Opaque on purpose: a second backdrop-filter nested inside the pill's
     would not blur the page, and it doubles the scroll-time GPU cost. */
  .nav-menu-list {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: 0.5rem;
    background: #ffffff;
    border: 1px solid rgba(23, 22, 22, 0.08);
    border-radius: var(--radius-cta);
    box-shadow:
      0 18px 40px -16px rgba(23, 22, 22, 0.24),
      0 4px 12px -4px rgba(23, 22, 22, 0.08);
  }

  @media (hover: hover) {
    .has-menu:hover .nav-menu {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
      transition:
        opacity 0.18s var(--ease-out),
        transform 0.22s var(--ease-out),
        visibility 0s linear 0s;
    }

    .has-menu:hover .nav-caret svg {
      transform: rotate(180deg);
    }
  }

  .has-menu.is-open .nav-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    transition:
      opacity 0.18s var(--ease-out),
      transform 0.22s var(--ease-out),
      visibility 0s linear 0s;
  }

  .has-menu.is-open .nav-caret svg {
    transform: rotate(180deg);
  }

  .nav-menu-link {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: 0.625rem 0.75rem;
    border-radius: 8px;
    transition: background-color 0.15s ease;
  }

  .nav-menu-link:hover,
  .nav-menu-link:focus-visible {
    background-color: rgba(216, 74, 41, 0.07);
  }

  .nav-menu-link:focus-visible {
    outline: 2px solid var(--color-brand-red);
    outline-offset: -2px;
  }

  .nav-menu-label {
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-text);
    transition: color 0.15s ease;
  }

  .nav-menu-link:hover .nav-menu-label,
  .nav-menu-link[aria-current="page"] .nav-menu-label {
    color: var(--color-brand-red);
  }

  .nav-menu-note {
    font-size: 0.8125rem;
    line-height: 1.35;
    color: var(--color-muted);
  }

  /* Long menus (Guides): two columns, so nine links stay short enough for a
     laptop-height window. */
  /* Guides is the last tab, so its menu hangs from the tab's right edge and
     grows leftwards; from the left edge it would run off a 1024px window. */
  .nav-menu--wide {
    left: auto;
    right: -1rem;
    min-width: min(34rem, calc(100vw - 4rem));
  }

  .nav-menu--wide .nav-menu-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.125rem 0.25rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-menu,
    .nav-caret svg {
      transition: none;
    }
  }

  /* App CTAs: one filled button, one quiet link. Which is which follows the
     device (see BaseLayout); DOM order and sizes never change, only `order`
     and paint, so the swap costs no layout shift. */
  .app-ctas {
    gap: 0.25rem;
  }

  .app-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: var(--spacing-btn-y) var(--spacing-btn-x);
    border-radius: var(--radius-cta);
    font-family: var(--font-ui);
    font-size: var(--text-nav);
    line-height: var(--leading-nav);
    letter-spacing: var(--tracking-cta);
    font-weight: 500;
    white-space: nowrap;
    text-decoration: none;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .app-cta:focus-visible {
    outline: 2px solid var(--color-brand-red);
    outline-offset: 2px;
  }

  /* Filled: the web app by default, the App Store on iPhone. */
  .app-cta[data-app-cta="web"],
  :global(html[data-platform="ios"]) .app-cta[data-app-cta="ios"] {
    order: 2;
    background-color: var(--color-ink);
    color: var(--color-cream);
  }

  .app-cta[data-app-cta="web"]:hover,
  :global(html[data-platform="ios"]) .app-cta[data-app-cta="ios"]:hover {
    background-color: var(--color-brand-red);
    color: #ffffff;
  }

  /* Quiet: the other one. */
  .app-cta[data-app-cta="ios"],
  :global(html[data-platform="ios"]) .app-cta[data-app-cta="web"] {
    order: 1;
    background-color: transparent;
    color: var(--color-ink);
  }

  .app-cta[data-app-cta="ios"]:hover,
  :global(html[data-platform="ios"]) .app-cta[data-app-cta="web"]:hover {
    background-color: transparent;
    color: var(--color-brand-red);
  }

  .app-cta[data-app-cta="ios"] svg,
  :global(html[data-platform="ios"]) .app-cta[data-app-cta="web"] svg {
    display: none;
  }

  :global(html[data-platform="ios"]) .app-cta[data-app-cta="ios"] svg {
    display: block;
  }

  /* Mobile menu: stacked, filled button on top. */
  .app-ctas--stacked {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
  }

  /* At 320px the filled button at full nav size is 12px wider than the menu's
     padded column, so the label scales down a step on the narrowest phones. */
  .app-ctas--stacked .app-cta {
    min-height: 2.75rem;
    font-size: clamp(1rem, 5vw, var(--text-nav));
  }

  .app-ctas--stacked .app-cta[data-app-cta="web"],
  :global(html[data-platform="ios"]) .app-ctas--stacked .app-cta[data-app-cta="ios"] {
    order: 1;
    padding-inline: var(--spacing-btn-x);
  }

  /* The quiet link lines up with the button's left edge, so no side padding.
     The filled rule above restates its padding because on iPhone the same
     element matches both this selector's first half and that one's second. */
  .app-ctas--stacked .app-cta[data-app-cta="ios"],
  :global(html[data-platform="ios"]) .app-ctas--stacked .app-cta[data-app-cta="web"] {
    order: 2;
    padding-inline: 0;
  }

  /* Short phones and landscape: two CTAs and the note no longer fit under the
     links, so the menu scrolls instead of clipping them. */
  .mobile-nav {
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .mobile-cta-block {
    padding-top: 2rem;
  }

  /* Hamburger morph */
  .ham-line {
    display: block;
    width: 22px;
    height: 1.5px;
    background-color: var(--color-ink);
    border-radius: 2px;
    position: absolute;
    left: 50%;
    transform-origin: center;
    transition:
      transform 0.26s var(--ease-out),
      opacity 0.18s ease;
  }

  .ham-line-1 {
    transform: translateX(-50%) translateY(-7px);
  }
  .ham-line-2 {
    transform: translateX(-50%) translateY(0px);
  }
  .ham-line-3 {
    transform: translateX(-50%) translateY(7px);
  }

  .hamburger.is-open .ham-line-1 {
    transform: translateX(-50%) translateY(0) rotate(45deg);
  }
  .hamburger.is-open .ham-line-2 {
    opacity: 0;
    transform: translateX(-50%) scaleX(0);
  }
  .hamburger.is-open .ham-line-3 {
    transform: translateX(-50%) translateY(0) rotate(-45deg);
  }

  /* Mobile nav overlay */
  .mobile-nav {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-6px);
    transition:
      opacity 0.22s var(--ease-out),
      transform 0.22s var(--ease-out),
      visibility 0s linear 0.22s;
  }

  .mobile-nav.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
    transition:
      opacity 0.22s var(--ease-out),
      transform 0.22s var(--ease-out),
      visibility 0s linear 0s;
  }

  /* Editorial mobile links */
  .mobile-link-list {
    border-left: 3px solid var(--color-brand-red);
    padding-left: 1.5rem;
  }

  .mobile-nav-link {
    font-size: clamp(2rem, 6vw, 2.75rem);
    letter-spacing: var(--tracking-tight);
    line-height: 1.2;
    display: block;
    padding: 0.3rem 0;
    color: var(--color-text);
    transition: color 0.15s ease;
  }

  .mobile-nav-link:hover,
  .mobile-nav-link-active {
    color: var(--color-brand-red);
  }

  /* A folded group (Guides): the summary looks like a top-level link, with a
     chevron that turns when it is open. */
  .mobile-group-summary {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    list-style: none;
    cursor: pointer;
  }

  .mobile-group-summary::-webkit-details-marker {
    display: none;
  }

  .mobile-group-summary svg {
    flex: none;
    color: var(--color-muted);
    transition: transform 0.24s var(--ease-out);
  }

  .mobile-group[open] .mobile-group-summary svg {
    transform: rotate(180deg);
  }

  .mobile-group-summary:focus-visible {
    outline: 2px solid var(--color-brand-red);
    outline-offset: 3px;
    border-radius: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-group-summary svg {
      transition: none;
    }
  }

  /* Children sit indented under their parent, one step down in size */
  .mobile-sub-list {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    margin: 0.125rem 0 0.5rem 0.25rem;
  }

  .mobile-sub-link {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.3rem 0;
    font-size: clamp(1.125rem, 3.4vw, 1.375rem);
    letter-spacing: -0.02em;
    color: var(--color-muted);
    transition: color 0.15s ease;
  }

  .mobile-sub-link::before {
    content: "";
    width: 0.875rem;
    height: 1.5px;
    background: currentColor;
    opacity: 0.45;
  }

  .mobile-sub-link:hover,
  .mobile-sub-link.mobile-nav-link-active {
    color: var(--color-brand-red);
  }

  .mobile-cta-note {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    color: var(--color-muted);
    opacity: 0.6;
    margin: 0.5rem 0 0;
  }

  /* Staggered reveals */
  .mobile-nav-item {
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.28s ease,
      transform 0.28s var(--ease-out);
    transition-delay: calc(var(--i) * 50ms + 60ms);
  }

  .mobile-nav.is-open .mobile-nav-item {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  function updateScrollState() {
    const pill = document.getElementById("nav-pill");
    if (!pill) return;
    pill.classList.toggle("is-scrolled", window.scrollY > 10);
  }

  // The navbar persists across View Transitions, so the server-rendered active
  // state goes stale on client-side navigation. data-match lists every path a
  // link counts as active on (a dropdown parent includes its children's paths);
  // aria-current stays on the link whose own page this is.
  function updateActiveLinks() {
    const path = window.location.pathname;
    const onPath = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
    document
      .querySelectorAll<HTMLAnchorElement>("#nav-pill a[data-match], #mobile-nav a[data-match]")
      .forEach((a) => {
        const isActive = (a.dataset.match ?? "").split(" ").some(onPath);
        const href = a.getAttribute("href") ?? "";
        const isCurrent = a.classList.contains("nav-link") ? path === href : isActive;
        a.classList.toggle("nav-link-active", a.classList.contains("nav-link") && isActive);
        a.classList.toggle(
          "mobile-nav-link-active",
          (a.classList.contains("mobile-nav-link") || a.classList.contains("mobile-sub-link")) &&
            isActive,
        );
        if (isCurrent) {
          a.setAttribute("aria-current", "page");
        } else {
          a.removeAttribute("aria-current");
        }
      });
    // A folded mobile group opens when the current page is one of its links.
    document.querySelectorAll<HTMLDetailsElement>("#mobile-nav .mobile-group").forEach((group) => {
      group.open = group.querySelector(".mobile-nav-link-active") !== null;
    });
  }

  function closeDropdowns(except?: Element) {
    document.querySelectorAll<HTMLElement>("#nav-pill .has-menu.is-open").forEach((item) => {
      if (item === except) return;
      item.classList.remove("is-open");
      item.querySelector(".nav-caret")?.setAttribute("aria-expanded", "false");
    });
  }

  function bindDropdowns() {
    document.querySelectorAll<HTMLElement>("#nav-pill .has-menu").forEach((item) => {
      const caret = item.querySelector<HTMLButtonElement>(".nav-caret");
      caret?.addEventListener("click", () => {
        const open = !item.classList.contains("is-open");
        closeDropdowns(item);
        item.classList.toggle("is-open", open);
        caret.setAttribute("aria-expanded", String(open));
      });
      // Close once keyboard focus leaves the parent and its menu.
      item.addEventListener("focusout", (e) => {
        if (!item.contains(e.relatedTarget as Node | null)) closeDropdowns();
      });
    });

    document.addEventListener("click", (e) => {
      if (!(e.target as Element | null)?.closest("#nav-pill .has-menu")) closeDropdowns();
    });
  }

  function openMenu() {
    const menu = document.getElementById("mobile-nav");
    const toggle = document.getElementById("nav-toggle");
    if (!menu || !toggle) return;
    menu.classList.add("is-open");
    toggle.classList.add("is-open");
    toggle.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
  }

  function closeMenu() {
    const menu = document.getElementById("mobile-nav");
    const toggle = document.getElementById("nav-toggle");
    if (!menu || !toggle) return;
    menu.classList.remove("is-open");
    toggle.classList.remove("is-open");
    toggle.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
  }

  // Bind interaction handlers exactly once. The navbar carries
  // transition:persist, so its DOM survives View Transition navigations —
  // re-binding on every page-load would leak listeners.
  function bindNavbarOnce() {
    const pill = document.getElementById("nav-pill");
    if (!pill || pill.dataset.navBound === "true") return;
    pill.dataset.navBound = "true";

    document.getElementById("nav-toggle")?.addEventListener("click", openMenu);
    document.getElementById("nav-close")?.addEventListener("click", closeMenu);

    window.addEventListener("scroll", updateScrollState, { passive: true });

    bindDropdowns();

    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      const menu = document.getElementById("mobile-nav");
      if (menu?.classList.contains("is-open")) closeMenu();
      const openItem = document.querySelector<HTMLElement>("#nav-pill .has-menu.is-open");
      if (openItem) {
        closeDropdowns();
        openItem.querySelector<HTMLButtonElement>(".nav-caret")?.focus();
      }
    });
  }

  // Per-page work — must re-run on every navigation.
  function refreshNavbar() {
    updateScrollState();
    updateActiveLinks();
  }

  // Reset body overflow and close menu before every navigation.
  document.addEventListener("astro:before-preparation", () => {
    document.body.style.overflow = "";
    closeDropdowns();
    const menu = document.getElementById("mobile-nav");
    const toggle = document.getElementById("nav-toggle");
    if (menu) menu.classList.remove("is-open");
    if (toggle) {
      toggle.classList.remove("is-open");
      toggle.setAttribute("aria-expanded", "false");
    }
  });

  // Run immediately on initial load — this module is deferred, so the DOM is
  // already parsed. Don't wait for astro:page-load, which can fire before this
  // script has executed on a cold load and be missed.
  bindNavbarOnce();
  refreshNavbar();

  // Re-run on subsequent View Transition navigations.
  document.addEventListener("astro:page-load", () => {
    bindNavbarOnce();
    refreshNavbar();
  });
</script>
