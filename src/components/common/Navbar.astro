  .app-ctas--stacked .app-cta[data-app-cta="web"],
  :global(html[data-platform="ios"]) .app-ctas--stacked .app-cta[data-app-cta="store"],
  :global(html[data-platform="android"]) .app-ctas--stacked .app-cta[data-app-cta="store"] {
    order: 1;
    background-color: var(--color-ink);
    color: var(--color-cream);
    box-shadow: none;
  }

  .app-ctas--stacked .app-cta[data-app-cta="store"],
  :global(html[data-platform="ios"]) .app-ctas--stacked .app-cta[data-app-cta="web"],
  :global(html[data-platform="android"]) .app-ctas--stacked .app-cta[data-app-cta="web"] {
