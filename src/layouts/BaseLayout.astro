---
import '../styles/global.css';
import Navbar from '../components/common/Navbar.astro';
import Footer from '../components/common/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import { organizationLd, serializeLd } from '../lib/seo';

const orgLd = serializeLd(organizationLd());

// Google Analytics (the <script> near the top of <head>).
// - gtag.js is 181 KB and used to be fetched from <head> markup on every page,
//   so it downloaded and ran while the page was still trying to paint. The
//   queue (dataLayer) is still set up at once; the library is requested right
//   after the first paint, at low priority. It is deliberately not held back
//   any longer (window load, idle time): a visitor who clicks straight through
//   to the web app would leave before it arrived and their page view would be
//   lost.
// - `window.gtag = gtag` matters. define:vars wraps the script in a function,
//   so without it `gtag` is not global and every `window.gtag?.(...)` call
//   elsewhere (SearchWebAppCTA's view and click events) silently does nothing
//   in production.
const GA_ID = 'G-RDVF45T3GX';

interface Props {
  title: string;
  description?: string;
  bodyBg?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  canonicalPath?: string;
}

const {
  title,
  description = '',
  bodyBg = '#ffffff',
  ogImage = '/og-default.png',
  ogType = 'website',
  noindex = false,
  canonicalPath,
} = Astro.props;

const canonicalUrl = new URL(canonicalPath ?? Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;
const robotsContent = noindex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    {import.meta.env.PROD && (
      <script is:inline define:vars={{ GA_ID }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){ dataLayer.push(arguments); }
        window.gtag = gtag;
        gtag('js', new Date());
        // Disable auto pageview — ClientRouter navigations are client-side,
        // so we fire page_view manually on every astro:page-load instead.
        gtag('config', GA_ID, { send_page_view: false });
        document.addEventListener('astro:page-load', () => {
          gtag('event', 'page_view', {
            page_title: document.title,
            page_location: location.href,
            page_path: location.pathname + location.search,
          });
        });

        (function () {
          var loaded = false;
          function loadGtag() {
            if (loaded) return;
            loaded = true;
            var s = document.createElement('script');
            s.async = true;
            s.fetchPriority = 'low';
            s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
            document.head.appendChild(s);
          }
          // Two frames: the first callback runs before the first paint, the
          // second after it.
          requestAnimationFrame(function () { requestAnimationFrame(loadGtag); });
          // A tab opened in the background gets no frames until it is shown.
          setTimeout(loadGtag, 3000);
        })();
      </script>
    )}

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#D84A29" />
    <meta name="apple-mobile-web-app-title" content="Unify" />
    {description && <meta name="description" content={description} />}
    <title>{title}</title>

    <!-- Canonical + robots -->
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={robotsContent} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Unify Social" />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Preload the fonts every first screen uses: Aileron body/nav/headings and
         Figtree for the CTA. All self-hosted (@font-face in global.css), so no
         third-party stylesheet blocks first paint. -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/Aileron-Regular.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/Aileron-SemiBold.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/Aileron-Bold.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/Figtree-latin.woff2" crossorigin />

    <!-- Which app CTA leads (Navbar, CTABand): "ios" on iPhone, where the App
         Store button is primary; "web" everywhere else, since the web app is
         the only option on desktop and Android. Inline in <head> so it is set
         before first paint (no flash, no layout shift); without JS the
         attribute is absent and the CSS default is the web app. ClientRouter
         replaces <html>'s attributes on each swap, so it is set again then. -->
    <script is:inline>
      (function () {
        function setPlatform() {
          document.documentElement.dataset.platform = /iPhone|iPod/.test(navigator.userAgent) ? "ios" : "web";
        }
        setPlatform();
        document.addEventListener("astro:after-swap", setPlatform);
      })();
    </script>

    <ClientRouter />

    <script type="application/ld+json" set:html={orgLd} />

    <slot name="head" />
  </head>
  <body class="font-display text-text" style={`background-color: ${bodyBg};`} data-body-bg={bodyBg}>
    <style is:global>
      /* Symmetric cross-dissolve */
      ::view-transition-old(root) {
        animation: vt-fade-out 0.18s ease forwards;
      }
      ::view-transition-new(root) {
        animation: vt-fade-in 0.22s ease forwards;
      }
      @keyframes vt-fade-out {
        to { opacity: 0; }
      }
      @keyframes vt-fade-in {
        from { opacity: 0; }
        to   { opacity: 1; }
      }

      /* Navbar excluded from root fade — persists across transitions */
      ::view-transition-old(navbar-pill),
      ::view-transition-new(navbar-pill) {
        animation: none;
      }
    </style>
    <script is:inline>
      history.scrollRestoration = "manual";
      document.addEventListener("astro:before-swap", (e) => {
        const newBg = e.newDocument.body.dataset.bodyBg ?? "#ffffff";
        document.body.style.backgroundColor = newBg;
      });
    </script>
    <Navbar transition:persist />
    <slot />
    <Footer />
  </body>
</html>
